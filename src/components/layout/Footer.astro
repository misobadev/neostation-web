---
import Logo from "@/assets/brand/logo-horizontal.svg";
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { href: "/downloads/", label: "Download" },
      { href: "/guide/", label: "Guide" },
      { href: "/integrations/", label: "Integrations" },
      { href: "/theme-designer/", label: "Theme Designer" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/misobadev/neostation-frontend", label: "Source code" },
      { href: "https://github.com/misobadev/neostation-frontend/issues", label: "Report an issue" },
      { href: "https://github.com/misobadev/neostation-frontend/releases", label: "Releases" },
      { href: "https://github.com/misobadev/neostation-web", label: "This website" },
      { href: "/brand-kit/", label: "Brand kit" },
    ],
  },
  {
    title: "Community",
    links: [
      { href: "https://discord.gg/xE2kgKsRVq", label: "Discord" },
      { href: "https://www.patreon.com/cw/NeoStation", label: "Patreon" },
    ],
  },
];

const linkClass = "text-[0.9375rem] text-bone-2 transition-colors hover:text-bone";
---

<footer class="border-t border-line bg-ink-2">
  <div class="mx-auto grid max-w-[76rem] gap-12 px-5 py-16 md:grid-cols-12 md:px-8">
    <div class="md:col-span-5">
      <a href="/" class="inline-flex text-bone" aria-label={`${siteConfig.title} home`}>
        <Logo height="30" width="224" class="h-[30px] w-auto" aria-hidden="true" />
      </a>
      <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-bone-2">
        All your retro games on every screen you own. Free and open source.
      </p>
    </div>

    {columns.map((col) => (
      <nav class="md:col-span-2 lg:col-span-2" aria-label={col.title}>
        <h2 class="label">{col.title}</h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {col.links.map((l) => {
            const external = l.href.startsWith("http");
            return (
              <li>
                <a href={l.href} class={linkClass} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                  {l.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-[76rem] flex-col gap-2 px-5 py-6 font-mono text-xs text-bone-3 sm:flex-row sm:justify-between md:px-8">
      <span>&copy; {year} {siteConfig.title}</span>
      <span>App GPL-3.0 · Website MIT</span>
    </div>
  </div>
</footer>
