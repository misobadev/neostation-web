---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();

const titleClass = "text-xs font-semibold uppercase tracking-widest text-base-content/40";
const linkClass =
  "text-sm text-base-content/60 transition-colors hover:text-primary";
---

<footer class="border-t border-base-300 bg-base-200 px-6 py-14">
  <div class="mx-auto grid max-w-7xl gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-flex items-center">
        <img
          src="/neostation-logo-dark-v2.webp"
          alt={siteConfig.title}
          class="h-8 w-auto"
          width="160"
          height="40"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-base-content/50">
        A modern, user-centric frontend for retro gaming. The app is open source
        under <strong class="text-base-content/70">GPL v3</strong>; this website
        is <strong class="text-base-content/70">MIT</strong> licensed.
      </p>
      <div class="mt-5 flex items-center gap-2">
        <a
          href="https://github.com/misobadev/neostation-frontend"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-content/60 transition hover:border-primary/50 hover:text-primary"
          aria-label="NeoStation on GitHub"
        >
          <Icon name="simple-icons:github" class="h-4 w-4" />
        </a>
        <a
          href="https://discord.gg/xE2kgKsRVq"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-content/60 transition hover:border-primary/50 hover:text-primary"
          aria-label="NeoStation on Discord"
        >
          <Icon name="simple-icons:discord" class="h-4 w-4" />
        </a>
        <a
          href="https://www.patreon.com/cw/NeoStation"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-content/60 transition hover:border-primary/50 hover:text-primary"
          aria-label="Become a Patron on Patreon"
        >
          <Icon name="simple-icons:patreon" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <nav class="flex flex-col gap-2.5">
      <h6 class={titleClass}>Product</h6>
      <a href="/downloads/" class={linkClass}>Downloads</a>
      <a href="/integrations/" class={linkClass}>Integrations</a>
      <a href="/guide/" class={linkClass}>Guide</a>
    </nav>

    <nav class="flex flex-col gap-2.5">
      <h6 class={titleClass}>Community</h6>
      <a href="https://github.com/misobadev/neostation-frontend" target="_blank" rel="noopener noreferrer" class={linkClass}>GitHub</a>
      <a href="https://discord.gg/xE2kgKsRVq" target="_blank" rel="noopener noreferrer" class={linkClass}>Discord</a>
      <a href="/theme-designer/" class={linkClass}>Theme Designer</a>
    </nav>

    <nav class="flex flex-col gap-2.5">
      <h6 class={titleClass}>Support</h6>
      <a href="https://www.patreon.com/cw/NeoStation" target="_blank" rel="noopener noreferrer" class={linkClass}>Patreon</a>
      <a href="https://github.com/misobadev/neostation-frontend/issues" target="_blank" rel="noopener noreferrer" class={linkClass}>Report an issue</a>
    </nav>
  </div>

  <div class="mx-auto mt-12 flex max-w-7xl flex-col items-center justify-between gap-3 border-t border-base-300 pt-8 text-xs text-base-content/40 sm:flex-row">
    <span>&copy; {year} {siteConfig.title}. All rights reserved.</span>
    <span>Made for the retro community.</span>
  </div>
</footer>
