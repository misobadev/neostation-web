/* </systems> */

/* Corners: the app's user setting, external/internal radius in app units. */
const CORNERS = [[0,0],[3,2],[8,5],[14,10],[16,12],[24,20]];

/* <presets> */
const PRESETS = {
  "dark":{"name":"Dark","brightness":"dark","colors":{"background":"#111216","surface":"#24252D","text":"#F1EDE4","border":"#2E3039","selection":"#F1EDE4","onSelection":"#111216","selectedCard":"#F1EDE4","onSelectedCard":"#111216","action":"#FF5A4A","onAction":"#111216","button":"#24252D","onButton":"#F1EDE4","success":"#33C27A","warning":"#F5B83D","error":"#FF5A4A","info":"#6E90FF"}},
