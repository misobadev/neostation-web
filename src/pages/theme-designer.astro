      <symbol id="i-clock" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20m0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16m-1 3h2v5.6l3.6 2.1-1 1.7-4.6-2.7z"/></symbol>
      <symbol id="i-gear" viewBox="0 0 24 24"><path d="M10.3 2h3.4l.5 2.6 1.9.8 2.2-1.5 2.4 2.4-1.5 2.2.8 1.9 2.6.5v3.4l-2.6.5-.8 1.9 1.5 2.2-2.4 2.4-2.2-1.5-1.9.8-.5 2.6h-3.4l-.5-2.6-1.9-.8-2.2 1.5-2.4-2.4 1.5-2.2-.8-1.9L2 13.7v-3.4l2.6-.5.8-1.9-1.5-2.2 2.4-2.4 2.2 1.5 1.9-.8zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7"/></symbol>
    </svg>
    
    <div class="workspace">
      <main class="stage">
        <div class="strip" id="strip" aria-hidden="true"><span class="lbl">Palette</span></div>
    
        <div class="stage-bar">
          <fieldset class="seg" id="viewSeg" aria-label="Preview screen">
            <button type="button" data-v="carousel" class="on">Carousel</button>
            <button type="button" data-v="grid">Grid</button>
            <button type="button" data-v="list">Game list</button>
          </fieldset>
          <div class="corners">
            <span class="lbl" id="cornersLbl">Corners</span>
            <fieldset class="seg small" id="cornerSeg" aria-labelledby="cornersLbl">
              <button type="button" data-c="0">0</button>
              <button type="button" data-c="1">XS</button>
              <button type="button" data-c="2">S</button>
              <button type="button" data-c="3" class="on">M</button>
              <button type="button" data-c="4">L</button>
              <button type="button" data-c="5">XL</button>
            </fieldset>
          </div>
        </div>
    
        <div class="bezel">
          <div class="screen">
            <div class="app" id="app">
    
              <!-- ============ CAROUSEL ============ -->
              <section class="view on" data-view="carousel">
                <div class="hdr" data-hdr="systems"></div>
                <div class="card rim" style="left:calc(var(--u)*-69);top:calc(var(--u)*83);width:calc(var(--u)*229);height:calc(var(--u)*278)">
                  <span class="art" style="left:calc(var(--u)*9);top:calc(var(--u)*9);right:calc(var(--u)*9);height:calc(var(--u)*218);background-image:url(https://cdn.neoassets.dev/packs/neostation/backgrounds/lynx.webp)"></span>
                  <span class="logo mask" style="top:calc(var(--u)*227);height:calc(var(--u)*49);left:calc(var(--u)*12);right:calc(var(--u)*12);-webkit-mask-image:url(/theme-designer/logos/lynx.webp);mask-image:url(/theme-designer/logos/lynx.webp)"></span>
                </div>
                <div class="card rim" style="left:calc(var(--u)*183);top:calc(var(--u)*57);width:calc(var(--u)*272);height:calc(var(--u)*331)">
                  <span class="art" style="left:calc(var(--u)*11);top:calc(var(--u)*11);right:calc(var(--u)*11);height:calc(var(--u)*260);background-image:url(https://cdn.neoassets.dev/packs/neostation/backgrounds/neogeo.webp)"></span>
                  <span class="logo mask" style="top:calc(var(--u)*270.5);height:calc(var(--u)*58.5);left:calc(var(--u)*14);right:calc(var(--u)*14);-webkit-mask-image:url(/theme-designer/logos/neogeo.webp);mask-image:url(/theme-designer/logos/neogeo.webp)"></span>
                </div>
                <div class="card rim" style="left:calc(var(--u)*479);top:calc(var(--u)*83);width:calc(var(--u)*229);height:calc(var(--u)*278)">
                  <span class="art" style="left:calc(var(--u)*9);top:calc(var(--u)*9);right:calc(var(--u)*9);height:calc(var(--u)*218);background-image:url(https://cdn.neoassets.dev/packs/neostation/backgrounds/gg.webp)"></span>
                  <span class="logo mask" style="top:calc(var(--u)*227);height:calc(var(--u)*49);left:calc(var(--u)*12);right:calc(var(--u)*12);-webkit-mask-image:url(/theme-designer/logos/gg.webp);mask-image:url(/theme-designer/logos/gg.webp)"></span>
                </div>
                <div class="chips" id="chips"></div>
                <div class="ftr" data-ftr="neogeo|128 Games|Enter"></div>
              </section>
    
              <!-- ============ GRID ============ -->
              <section class="view" data-view="grid">
                <div class="grid" id="grid"></div>
                <div class="hdr" data-hdr="systems"></div>
                <div class="ftr" data-ftr="Last Played: Bubble Bobble||Play"></div>
              </section>
    
              <!-- ============ GAME LIST ============ -->
              <section class="view" data-view="list">
                <div class="fan" style="background-image:url(/theme-designer/game/bubblebobble-fanart.webp)"></div>
                <div class="abs side-panel glass rim">
                  <span class="syslogo mask" style="-webkit-mask-image:url(/theme-designer/game/gba-logo.webp);mask-image:url(/theme-designer/game/gba-logo.webp)"></span>
                  <div class="rows" id="rows"></div>
                </div>
                <svg class="dpad" style="left:calc(var(--u)*381)"><use href="#i-dpad"/></svg>
                <div class="tabs dtabs rim">
                  <span class="tab sel"><svg class="ico"><use href="#i-card"/></svg></span>
                  <span class="tab"><svg class="ico"><use href="#i-folder"/></svg></span>
                  <span class="tab"><svg class="ico"><use href="#i-image"/></svg></span>
                  <span class="tab"><svg class="ico"><use href="#i-info"/></svg></span>
                  <span class="tab"><svg class="ico"><use href="#i-trophy"/></svg></span>
                </div>
                <svg class="dpad" style="right:calc(var(--u)*15)"><use href="#i-dpad"/></svg>
                <img class="wheel" src="/theme-designer/game/bubblebobble-wheel.webp" alt="" />
                <div class="romline"><span class="romname">Bubble Bobble - Old &amp; New (USA).zip</span></div>
                <div class="gfoot rating glass rim"><svg class="ico"><use href="#i-star"/></svg>8</div>
                <div class="gfoot ra glass rim">
                  <span class="icon" style="background-image:url(/theme-designer/game/bubblebobble-wheel.webp);background-color:#fff;background-size:90%"></span>
                  <span class="txt">0/63<span class="bar"><i></i></span></span>
                </div>
                <div class="gfoot round glass rim" style="left:calc(var(--u)*401)"><svg class="ico"><use href="#i-dice"/></svg></div>
                <div class="gfoot round fav glass rim" style="left:calc(var(--u)*446)"><svg class="ico"><use href="#i-heart"/></svg></div>
                <div class="gfoot round glass rim" style="left:calc(var(--u)*491)"><svg class="ico"><use href="#i-gear"/></svg></div>
                <div class="gfoot play">PLAY</div>
              </section>
    
            </div>
          </div>
        </div>
        <p class="hint" id="legend"></p>
      </main>
    
      <aside class="panel">
        <div class="stack">
          <div class="two">
            <div>
              <label class="fld" for="preset">Start from</label>
              <select id="preset"></select>
            </div>
            <button class="btnx" id="importBtn" type="button">Import JSON</button>
            <input type="file" id="fileInput" class="file-hide" accept=".json,application/json" />
          </div>
          <div><label class="fld" for="tName">Theme name</label><input type="text" id="tName" value="My Custom Theme" /></div>
          <div><label class="fld" for="tId">Theme id</label><input type="text" id="tId" value="my_custom_theme" spellcheck="false" /></div>
          <div><label class="fld" for="tAuthor">Author</label><input type="text" id="tAuthor" placeholder="Your name or handle" /></div>
          <fieldset class="seg full" id="brightSeg" aria-label="Brightness">
            <button type="button" data-b="dark" class="on">Dark</button>
            <button type="button" data-b="light">Light</button>
          </fieldset>
        </div>
    
        <div id="groups"></div>
    
        <p class="note">Corners aren't part of a theme: everyone picks their own in NeoStation under Settings › Themes › Corners. In NeoStation, import the file under Settings › Themes › Import Theme.</p>
    
        <div class="export">
          <button class="btnx" id="copyBtn" type="button">Copy JSON</button>
          <button class="btnx primary" id="dlBtn" type="button">Download</button>
        </div>
      </aside>
    </div>
    
    <div class="toast" id="toast">Copied</div>
  </div>
</Base>

<script is:inline>
/* =====================================================================
   NeoStation theme model: the 16 colours the app uses, named after where
   they show. Exported as {"format":"neostation-theme","version":2,…}.
   ===================================================================== */
const GROUPS = [
  { title:'Base', n:'01', desc:'The screen and everything that sits on it.', fields:[
    ['background','Background','Screen background'],
    ['surface','Cards','Cards, pills, panels'],
    ['text','Text','Text and icons'],
    ['border','Border','Borders and lines'],
  ]},
  { title:'Selection', n:'02', desc:'What the D-pad is on.', fields:[
    ['selection','Selection','Selected tab, chip and game row'],
    ['onSelection','Text on selection','Text and icons on it',true],
    ['selectedCard','Selected card','Selected card in the grid, game count'],
    ['onSelectedCard','Text on selected card','Logo and text on it',true],
  ]},
  { title:'Buttons', n:'03', desc:'The footer’s buttons.', fields:[
    ['action','Main button','Enter and Play'],
    ['onAction','Text on main button','Label and glyph on it',true],
    ['button','Button','Options and Search'],
    ['onButton','Text on button','Label and glyph on it',true],
  ]},
  { title:'Status', n:'04', desc:'Battery, rating, favourites, notifications.', fields:[
    ['success','Success','Battery full, high ratings'],
    ['warning','Warning','Battery medium, notifications, achievement progress'],
    ['error','Error','Battery low, favourites, low ratings'],
    ['info','Info','Charging'],
  ]},
];
const FIELDS = GROUPS.flatMap(g=>g.fields.map(f=>f[0]));

/* Contrast each colour needs, and against what (WCAG ratios). */
const CONTRAST = {
  text:[['background','surface'],4.5],
  onSelection:[['selection'],4.5], onSelectedCard:[['selectedCard'],4.5],
  onAction:[['action'],4.5], onButton:[['button'],4.5],
  selection:[['background'],3], selectedCard:[['background'],3], action:[['background'],3],
  success:[['background'],3], warning:[['background'],3], error:[['background'],3], info:[['background'],3],
};

/* Art comes from the official NeoStation pack on NeoAssets. */
const CDN='https://cdn.neoassets.dev/packs/neostation/backgrounds/';

/* System names from the NeoAssets catalog (refresh with systems.mjs). */
/* <systems> */
const SYSTEMS = {
  "neogeo":{"name":"Neo Geo","short":"Neo Geo"},
