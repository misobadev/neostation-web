  "horizon":{"name":"Horizon","brightness":"dark","colors":{"background":"#16161C","surface":"#1C1E26","text":"#D5D8DA","border":"#1F222B","selection":"#E95678","onSelection":"#1A0A0E","selectedCard":"#F09383","onSelectedCard":"#1A0D0B","action":"#E95678","onAction":"#1A0A0E","button":"#1C1E26","onButton":"#D5D8DA","success":"#09F7A0","warning":"#FAB28E","error":"#E9436F","info":"#21BFC2"}},
  "dmg":{"name":"DMG","brightness":"dark","colors":{"background":"#9BBC0F","surface":"#8BAC0F","text":"#0F380F","border":"#306230","selection":"#0F380F","onSelection":"#9BBC0F","selectedCard":"#306230","onSelectedCard":"#9BBC0F","action":"#0F380F","onAction":"#9BBC0F","button":"#8BAC0F","onButton":"#0F380F","success":"#0F380F","warning":"#306230","error":"#4A2A0F","info":"#0F380F"}},
  "sixteen_bit":{"name":"16 Bits","brightness":"light","colors":{"background":"#DDDBD6","surface":"#CBC8C1","text":"#2A2C31","border":"#A9A59D","selection":"#3E4248","onSelection":"#EDEBE6","selectedCard":"#2D55B0","onSelectedCard":"#FFFFFF","action":"#CC2F38","onAction":"#FFFFFF","button":"#CBC8C1","onButton":"#2A2C31","success":"#23843F","warning":"#8A6A00","error":"#B42A32","info":"#2D55B0"}},
};
/* </presets> */

/* ---- colour helpers ---- */
function parseOklch(str){
  const m=String(str).match(/oklch\(\s*([\d.]+)%?\s+([\d.]+)\s+([\d.-]+)/i);
  if(!m) return {L:0,C:0,H:0};
  let L=Number.parseFloat(m[1]); if(str.includes('%')) L/=100;
  return {L, C:Number.parseFloat(m[2]), H:Number.parseFloat(m[3])};
}
function oklchToHex(str){
  const {L,C,H}=parseOklch(str);
  const hr=H*Math.PI/180;
  const a=C*Math.cos(hr);
  const b=C*Math.sin(hr);
  const l_=L+0.3963377774*a+0.2158037573*b;
  const m_=L-0.1055613458*a-0.0638541728*b;
  const s_=L-0.0894841775*a-1.2914855480*b;
  const l=l_**3;
  const m=m_**3;
  const s=s_**3;
  const r= 4.0767416621*l-3.3077115913*m+0.2309699292*s;
  const g=-1.2684380046*l+2.6097574011*m-0.3413193965*s;
  const bl=-0.0041960863*l-0.7034186147*m+1.7076147010*s;
  const gam=c=>{const v=c<=0.0031308?12.92*c:1.055*c ** (1/2.4)-0.055; return Math.max(0,Math.min(1,v));};
  const h2=x=>Math.round(gam(x)*255).toString(16).padStart(2,'0');
  return `#${h2(r)}${h2(g)}${h2(bl)}`;
}
function toHex(v){
  const s=String(v||'').trim();
  if(/oklch/i.test(s)) return oklchToHex(s).toUpperCase();
  let h=s.replace('#','');
  if(h.length===3) h=h.split('').map(c=>c+c).join('');
  if(h.length===8) h=h.slice(2);
  return /^[0-9a-fA-F]{6}$/.test(h)?`#${h.toUpperCase()}`:null;
}
function lum(hex){
  const h=hex.replace('#','');
  const c=[0,2,4].map(i=>{const v=Number.parseInt(h.slice(i,i+2),16)/255; return v<=0.03928?v/12.92:((v+0.055)/1.055)**2.4;});
  return 0.2126*c[0]+0.7152*c[1]+0.0722*c[2];
}
function ratio(a,b){ const x=lum(a); const y=lum(b); return (Math.max(x,y)+0.05)/(Math.min(x,y)+0.05); }

/* ---- model ---- */
function newModel(){ return { name:'My Custom Theme', id:'my_custom_theme', author:'', brightness:'dark', colors:{} }; }
let model=newModel();
let corner=3;
const $=s=>document.querySelector(s);
const rows={};

function buildGroups(){
  const root=$('#groups'); root.innerHTML='';
  for(const g of GROUPS){
    const el=document.createElement('div'); el.className='group';
    el.innerHTML=`<h3><span class="n">${g.n}</span>${g.title}</h3><p>${g.desc}</p>`;
    for(const [field,label,desc,isOn] of g.fields){
      const row=document.createElement('div'); row.className='sw';
      row.innerHTML=`
        <span class="pick"><input type="color" aria-label="${label} colour" /></span>
        <span class="${isOn?'on-row':''}"><span class="nm">${label}</span><span class="ds">${desc}</span></span>
        <span class="cr"></span>
        <input class="hex" type="text" spellcheck="false" maxlength="7" aria-label="${label} hex" />`;
      const color=row.querySelector('input[type=color]');
      const hex=row.querySelector('.hex');
      rows[field]={color,hex,pick:row.querySelector('.pick'),cr:row.querySelector('.cr')};
      color.addEventListener('input',()=>setField(field,color.value));
      hex.addEventListener('input',()=>{ const h=toHex(hex.value); if(h&&hex.value.replace('#','').length===6) setField(field,h,true); });
      hex.addEventListener('blur',()=>syncOne(field));
      el.appendChild(row);
    }
    root.appendChild(el);
  }
}

function setField(field,hex,fromHex){ model.colors[field]=hex.toUpperCase(); if(!fromHex) syncOne(field); else syncSwatch(field); refresh(); }
function syncSwatch(field){ const r=rows[field]; const v=model.colors[field]; if(!r||!v) return; r.color.value=v.toLowerCase(); r.pick.style.background=v; }
function syncOne(field){ syncSwatch(field); const r=rows[field]; if(r) r.hex.value=model.colors[field]; }
function syncAll(){ for(const f of FIELDS) syncOne(f); }

function syncContrast(){
  for(const [field,[against,min]] of Object.entries(CONTRAST)){
    const r=rows[field]; if(!r) continue;
    const v=Math.min(...against.map(a=>ratio(model.colors[field],model.colors[a])));
    r.cr.textContent=`${v.toFixed(1)}:1`;
    r.cr.className=`cr ${v>=min?'ok':'bad'}`;
    r.cr.title=v>=min?`Readable (needs ${min}:1)`:`Hard to read: needs at least ${min}:1`;
  }
}

/* Paints the mock with the model. */
function applyPreview(){
  const app=$('#app'); const c=model.colors;
  const vars={'--bg':c.background,'--surface':c.surface,'--text':c.text,'--border':c.border,
    '--sel':c.selection,'--onSel':c.onSelection,'--scard':c.selectedCard,'--onScard':c.onSelectedCard,
    '--act':c.action,'--onAct':c.onAction,'--btn':c.button,'--onBtn':c.onButton,
    '--ok':c.success,'--warn':c.warning,'--err':c.error,'--info':c.info};
  for(const [k,v] of Object.entries(vars)) app.style.setProperty(k,v);
  // The app's glass rim: a faint white highlight on dark grounds, the text
  // colour on light ones, where a highlight would vanish.
  const light=lum(c.background)>0.4;
  const ink=a=>`color-mix(in srgb, ${c.text} ${a}%, transparent)`;
  app.style.setProperty('--rimg', light
    ? `linear-gradient(to bottom right, ${ink(22)} 0%, ${ink(16)} 60%, ${ink(12)} 100%)`
    : 'linear-gradient(to bottom right, rgba(255,255,255,.08) 0%, rgba(255,255,255,.05) 60%, rgba(255,255,255,.012) 100%)');
  app.style.setProperty('--rimblend', light?'normal':'plus-lighter');
  const [rx,rxi]=CORNERS[corner];
  app.style.setProperty('--rx',rx); app.style.setProperty('--rxi',rxi);
  const strip=$('#strip');
  for(const d of strip.querySelectorAll('.dot')) d.remove();
  for(const f of FIELDS){ const d=document.createElement('span'); d.className='dot'; d.style.background=c[f]; d.title=`${f} ${c[f]}`; strip.appendChild(d); }
}
function refresh(){ applyPreview(); syncContrast(); }

/* ---- shared mock pieces ---- */
function buildHeaders(){
  for(const h of document.querySelectorAll('[data-hdr]')){
    h.innerHTML=`
      <span class="pill search rim"><span class="mask pad-x"></span>Search</span>
      <span class="bump mask ni-lb" style="left:calc(var(--u)*209)"></span>
      <span class="tabs rim" style="left:calc(var(--u)*235)">
        <span class="tab sel"><span class="mask ni-grids"></span></span>
        <span class="tab"><svg class="ico"><use href="#i-store"/></svg></span>
        <span class="tab"><span class="mask ni-cloud"></span></span>
        <span class="tab"><span class="mask ni-trophy"></span></span>
        <span class="tab"><span class="mask ni-gear"></span></span>
      </span>
      <span class="bump mask ni-rb" style="left:calc(var(--u)*411)"></span>
      <span class="pill status rim"><svg class="ico"><use href="#i-bell"/></svg>15:07<span class="bat"><svg class="ico" viewBox="0 0 26 24"><use href="#i-bat"/></svg>100%</span></span>`;
  }
  for(const f of document.querySelectorAll('[data-ftr]')){
    const [id,count,enter]=f.dataset.ftr.split('|');
    const name=SYSTEMS[id]?.short||id;
    const countChip=count?`<span class="count">${count}</span>`:'';
    f.innerHTML=`
      <span class="pill name rim">${name}${countChip}</span>
      <span class="pill fbtn opts rim" style="left:calc(var(--u)*463)"><span class="mask pad-menu"></span>Options</span>
      <span class="pill fbtn enter rim" style="left:calc(var(--u)*557)"><span class="mask pad-a"></span>${enter}</span>`;
  }
}

/* The systems grid: six columns, the recent game spanning two. */
function buildGrid(){
  // Measured on the device: 92-wide cards, 10 between columns, 7.5 between rows.
  const cols=6; const x0=18; const w=92; const gap=10; const y0=55; const h=117; const vgap=7.5;
  const cards=[
    ['recent',1],['all'],['favorites'],['collections'],['android'],
    ['arc'],['a2'],['2600'],['cv'],['vect'],['msx'],
    ['nes'],['sg1k'],['fc'],['cpc'],['sms'],['mark3'],
    ['lynx'],['neogeo'],['gg'],['snes'],['favorites'],['arc'],
  ];
  let col=0; let row=0; let html='';
  for(const [id,sel] of cards){
    const span=id==='recent'?2:1;
    if(col+span>cols){ col=0; row++; }
    const left=x0+col*(w+gap); const top=y0+row*(h+vgap); const width=w*span+gap*(span-1);
    const inner=id==='recent'
      // The last game played: its logo over its own art.
      ? `<span class="art" style="left:calc(var(--u)*4);top:calc(var(--u)*4);right:calc(var(--u)*4);height:calc(var(--u)*81);background-image:url(/theme-designer/game/bubblebobble-wheel.webp),url(/theme-designer/game/bubblebobble-fanart.webp);background-size:auto 80%,cover"></span>`
      : id==='all'
      ? '<span class="art logo-all" style="left:calc(var(--u)*4);top:calc(var(--u)*4);right:calc(var(--u)*4);height:calc(var(--u)*85)"></span>'
      : `<span class="art" style="left:calc(var(--u)*4);top:calc(var(--u)*4);right:calc(var(--u)*4);height:calc(var(--u)*85);background-image:url(${CDN}${id}.webp)"></span>`;
    const foot=id==='recent'
      ? '<span class="foot" style="top:calc(var(--u)*85);height:calc(var(--u)*32)">TIME PLAYED: 4 SECONDS</span>'
      : `<span class="logo mask" style="top:calc(var(--u)*89);height:calc(var(--u)*26);left:calc(var(--u)*8);right:calc(var(--u)*8);-webkit-mask-image:url(/theme-designer/logos/${id}.webp);mask-image:url(/theme-designer/logos/${id}.webp)"></span>`;
    html+=`<div class="card rim${sel?' selcard':''}${id==='recent'?' rec':''}" style="left:calc(var(--u)*${left});top:calc(var(--u)*${top});width:calc(var(--u)*${width});height:calc(var(--u)*${h})">${inner}${foot}</div>`;
    col+=span;
  }
  $('#grid').innerHTML=html;
}

/* The carousel's chip track, centred on the selected system as in the app. */
function buildChips(){
  const chip=(id,sel)=>`<span class="chip rim${sel?' sel':''}">${(SYSTEMS[id]?.short||id).toUpperCase()}</span>`;
  $('#chips').innerHTML=
    `<div class="side l">${['sms','pccd','tgcd','gb','tg16','lynx'].map(id=>chip(id)).join('')}</div>`+
    chip('neogeo',true)+
    `<div class="side">${['gg','snes','sfc','scd','cps2','jag'].map(id=>chip(id)).join('')}</div>`;
}

function buildRows(){
  const games=['007 : Nightfire','Ace Combat Advance','Action Man : Robot Atak','Activision Anthology','Advance Guardian Heroes','Advance Wars','Advance Wars 2 : Black Hole Rising','Aladdin','Alien Hominid','Alienators : Evolution Continues','An American Tail: Fievel’s Gold Rush','Animal Snap : Rescue Them 2 by 2','Army Men : Operation Green'];
  const heart='<svg class="ico heart"><use href="#i-heart"/></svg>';
  $('#rows').innerHTML=
    `<div class="row sel">${heart}<span class="t">Bubble Bobble : Old &amp; New</span><svg class="ico"><use href="#i-download"/></svg></div>`+
    `<div class="row">${heart}<span class="t">Goodboy Galaxy</span></div>`+
    games.map(g=>`<div class="row"><span class="t">${g}</span></div>`).join('');
}

const LEGEND={
  carousel:'Screen <b>Background</b> · cards, chips and pills <b>Cards</b> with <b>Text</b> · selected tab and chip <b>Selection</b> · game count <b>Selected card</b> · Options and Search <b>Button</b> · Enter <b>Main button</b> · battery <b>Success</b>. The centred card keeps the card colour.',
  grid:'Selected card (here the last game played) <b>Selected card</b> with its text in <b>Text on selected card</b> · other cards <b>Cards</b> · selected tab <b>Selection</b> · Options <b>Button</b> · Play <b>Main button</b>.',
  list:'Sidebar, rating, achievements and round buttons are glass: <b>Background</b> let through over the game art · selected game <b>Selection</b> · PLAY <b>Main button</b> · achievement progress <b>Warning</b> · favourite hearts <b>Error</b> · rating star mixes <b>Error</b> and <b>Success</b>. The file name is always white, as in the app.',
};
function setView(v){
  for(const el of document.querySelectorAll('.view')) el.classList.toggle('on',el.dataset.view===v);
  for(const b of document.querySelectorAll('#viewSeg button')) b.classList.toggle('on',b.dataset.v===v);
  $('#legend').innerHTML=LEGEND[v];
}
function setCorner(i){
  corner=i;
  for(const b of document.querySelectorAll('#cornerSeg button')) b.classList.toggle('on',Number(b.dataset.c)===i);
  applyPreview();
}
function setBright(b){ model.brightness=b==='light'?'light':'dark'; for(const x of document.querySelectorAll('#brightSeg button')) x.classList.toggle('on',x.dataset.b===model.brightness); }

/* ---- import / export ---- */
function snake(s){ return String(s||'').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'')||'my_theme'; }

/* Accepts the v2 format and the older daisyUI-style JSON. */
function fromJson(m){
  const src=m.colors||m;
  const pick=(k,fb)=>toHex(src[k])||fb;
  const base=PRESETS.dark.colors;
  const colors={};
  if(m.format==='neostation-theme'||src.background!=null){
    for(const f of FIELDS) colors[f]=pick(f,base[f]);
  }else{
    const map={background:'base-100',surface:'base-200',text:'base-content',border:'base-300',
      selection:'primary',onSelection:'primary-content',selectedCard:'secondary',onSelectedCard:'secondary-content',
      action:'primary',onAction:'primary-content',button:'base-200',onButton:'base-content',
      success:'success',warning:'warning',error:'error',info:'info'};
    for(const f of FIELDS) colors[f]=pick(map[f],base[f]);
  }
  const b=String(m.brightness||m.colorScheme||m.scheme||'dark').toLowerCase();
  return { name:m.name||'Imported Theme', id:snake(m.id||m.name), author:m.author||'', brightness:b==='light'?'light':'dark', colors };
}
function loadModel(m){
  model=fromJson(m);
  $('#tName').value=model.name; $('#tId').value=model.id; $('#tAuthor').value=model.author;
  setBright(model.brightness); syncAll(); refresh();
}
function exportJson(){
  const colors={}; for(const f of FIELDS) colors[f]=model.colors[f];
  return JSON.stringify({ format:'neostation-theme', version:2, name:model.name, id:snake(model.id||model.name),
    author:model.author, brightness:model.brightness, colors }, null, 2);
}

let toastT;
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('show'),1600); }

function init(){
  buildGroups(); buildHeaders(); buildGrid(); buildChips(); buildRows();
  const sel=$('#preset');
  for(const [k,p] of Object.entries(PRESETS)){ const o=document.createElement('option'); o.value=k; o.textContent=p.name; sel.appendChild(o); }
  sel.value='dark';
  sel.addEventListener('change',()=>{ const p=PRESETS[sel.value];
    loadModel({name:$('#tName').value,id:$('#tId').value,author:$('#tAuthor').value,brightness:p.brightness,colors:p.colors});
    toast(`${p.name} loaded`); });
  $('#tName').addEventListener('input',e=>{ model.name=e.target.value; });
  $('#tId').addEventListener('input',e=>{ model.id=e.target.value.trim(); });
  $('#tId').addEventListener('blur',e=>{ model.id=snake(e.target.value); e.target.value=model.id; });
  $('#tAuthor').addEventListener('input',e=>{ model.author=e.target.value; });
  $('#brightSeg').addEventListener('click',e=>{ const b=e.target.dataset.b; if(b) setBright(b); });
  $('#viewSeg').addEventListener('click',e=>{ const v=e.target.dataset.v; if(v) setView(v); });
  $('#cornerSeg').addEventListener('click',e=>{ const c=e.target.dataset.c; if(c!=null) setCorner(Number(c)); });
  $('#copyBtn').addEventListener('click',()=>navigator.clipboard.writeText(exportJson()).then(()=>toast('JSON copied')));
  $('#dlBtn').addEventListener('click',()=>{
    const blob=new Blob([exportJson()],{type:'application/json'});
    const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`${snake(model.id)}.json`;
    a.click(); URL.revokeObjectURL(a.href); toast('Downloaded'); });
  $('#importBtn').addEventListener('click',()=>$('#fileInput').click());
  $('#fileInput').addEventListener('change',e=>{ const f=e.target.files[0]; if(!f) return;
    const r=new FileReader(); r.onload=()=>{ try{ loadModel(JSON.parse(r.result)); sel.value=''; toast('Imported'); }catch(_err){ toast('Not a theme file'); } };
    r.readAsText(f); e.target.value=''; });

  loadModel({...PRESETS.dark, name:'My Custom Theme', id:'my_custom_theme'});
  setView('carousel');
}
init();
</script>
