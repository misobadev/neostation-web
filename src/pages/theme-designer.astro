---
// NeoStation Theme Designer — route: /theme-designer/.
// GENERATED from scripts/theme/source.html by scripts/theme/build.mjs.
// Do not edit by hand — edit source.html and run `npm run build:theme`.
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import "@fontsource/anta";
// Page-scoped styles, imported here rather than in global.css so only
// /theme-designer/ pays for them.
import "@/styles/components/theme-designer.css";
import type { SiteMeta } from "@/types";

const meta: SiteMeta = {
  title: "Theme Designer",
  description:
    "Design a NeoStation theme with a live preview of the systems carousel, the systems grid and the game list, then export it as JSON and import it in NeoStation.",
};
---

<Base meta={meta}>
  <!-- Intro -->
  <PageHero
    label="Theme Designer"
    title="Make NeoStation yours."
    lead="Pick colours for the carousel, the grid and the game list and watch them update live. Export the theme as JSON, then import it in NeoStation under Settings › Themes › Import Theme."
  >
    <a
      href="https://discord.gg/xE2kgKsRVq"
      target="_blank"
      rel="noopener"
      class="label mt-5 inline-block underline decoration-bone-3 underline-offset-4 transition-colors hover:text-bone hover:decoration-bone"
      >Share themes on Discord</a
    >
  </PageHero>

  <div class="tb mt-12 md:mt-16">
    
    
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-store" viewBox="0 0 24 24"><path d="M4 4h16l1.5 5a3 3 0 0 1-5 2.3 3 3 0 0 1-4.5 0 3 3 0 0 1-4.5 0A3 3 0 0 1 2.5 9zM5 13.4a4.6 4.6 0 0 0 2.5 0V19h9v-5.6a4.6 4.6 0 0 0 2.5 0V21H5z"/></symbol>
      <symbol id="i-bell" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0-6 6v4l-2 3v1h16v-1l-2-3V9a6 6 0 0 0-6-6m-2.5 16a2.5 2.5 0 0 0 5 0z"/></symbol>
      <symbol id="i-bat" viewBox="0 0 26 24"><path d="M3 7h17a2 2 0 0 1 2 2v1h1.5v4H22v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2m0 2v6h17V9z"/><path d="M4.5 10.5h14v3h-14z"/></symbol>
      <symbol id="i-dpad" viewBox="0 0 24 24"><path d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7z"/></symbol>
      <symbol id="i-card" viewBox="0 0 24 24"><path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2m1 3v6h9V8z"/></symbol>
      <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 5h7l2 2h8a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1"/></symbol>
      <symbol id="i-image" viewBox="0 0 24 24"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1m1 13h14l-4.5-6-3.5 4.5-2.5-3z"/></symbol>
      <symbol id="i-info" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20m-1 8v7h2v-7zm0-3v2h2V7z"/></symbol>
      <symbol id="i-trophy" viewBox="0 0 24 24"><path d="M6 3h12v4a6 6 0 0 1-5 5.9V16h3v3H8v-3h3v-3.1A6 6 0 0 1 6 7zM2 4h3v3a3 3 0 0 1-3-3m17 0h3a3 3 0 0 1-3 3z"/></symbol>
      <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 2 3 6.6 7.2.8-5.4 4.9 1.6 7.1L12 17.8l-6.4 3.6 1.6-7.1L1.8 9.4 9 8.6z"/></symbol>
      <symbol id="i-dice" viewBox="0 0 24 24"><path d="M6 3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3m0 2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1zm2.5 2a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3m7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3m-3.5 3.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M8.5 14a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3m7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3"/></symbol>
      <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 21s-8.5-5.3-8.5-11.2A4.8 4.8 0 0 1 12 6.6a4.8 4.8 0 0 1 8.5 3.2C20.5 15.7 12 21 12 21"/></symbol>
