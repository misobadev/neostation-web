---
import PageHero from "@/components/PageHero.astro";
import PageLayout from "@/layouts/Base.astro";
import { Icon } from "astro-icon/components";
import fs from "node:fs";
import path from "node:path";

const meta = {
  description:
    "Set up NeoStation in minutes: install it, pick your ROMs folder and play. Includes the folder name for every supported system and how to set up NeoSync.",
  title: "User guide",
};

// Automate Folder Compatibility Table
const systemsDir = path.resolve("./public/systems");
const files = fs
  .readdirSync(systemsDir)
  .filter(
    (f) =>
      f.endsWith(".json") &&
      !["all.json", "android.json", "manifest.json"].includes(f),
  );

const allSystems = files.map((file) => {
  const content = fs.readFileSync(path.join(systemsDir, file), "utf-8");
  return JSON.parse(content);
});

const sortedSystems = allSystems.sort((a, b) =>
  a.system.name.localeCompare(b.system.name),
);

const systemsManifest = JSON.parse(
  fs.readFileSync(path.join(systemsDir, "manifest.json"), "utf-8"),
);
const systemsVersion: string = systemsManifest.latest_version ?? "N/A";

const totalSystems = sortedSystems.length;
const emulationCompatibleCount = sortedSystems.filter(
  (s) => s.emulators && s.emulators.length > 0,
).length;
const neosyncCompatibleCount = sortedSystems.filter(
  (s) => s.neosync.sync,
).length;

const systemTypeMeta: Record<string, { label: string; icon: string }> = {
  console: { label: "Console", icon: "mdi:television-classic" },
  handheld: { label: "Handheld", icon: "mdi:hand-coin" },
  computer: { label: "Computer", icon: "mdi:desktop-tower-monitor" },
  virtual: { label: "Virtual", icon: "mdi:memory" },
  arcade: { label: "Arcade", icon: "mdi:gamepad-variant" },
};

const systemTypes = Object.entries(systemTypeMeta);

const toc = [
  { id: "getting-started", label: "Getting Started" },
  { id: "installation", label: "Installation" },
  { id: "setup-configuration", label: "Setup & Config" },
  { id: "neosync", label: "Integrations" },
  { id: "folder-compatibility", label: "Folder Structure" },
  { id: "wiki", label: "Wiki" },
];

const integrations = [
  {
    name: "NeoSync",
    img: "/providers/neosync.svg",
    role: "Cloud saves",
    url: "https://neosync.cloud",
    host: "neosync.cloud",
    body: "NeoStation's cloud save engine. Saves and states sync atomically across Windows, Android, macOS and Linux, with no manual intervention needed.",
    tagsLabel: "Emulators",
    tags: ["RetroArch", "RetroArch32", "RetroArch64", "Eden", "Citro", "NetherSX2"],
    note: "The Free Plan (4 MB) is enough for thousands of save files. NeoSync is optional: NeoStation works fully offline. RetroArch saves sync on their own; for standalone emulators, set each save folder once in NeoSync → Custom Save Folders.",
    wiki: "https://wiki.neostation.dev/features/neosync/",
  },
  {
    name: "RomM",
    img: "/providers/romm.svg",
    role: "ROM manager",
    url: "https://romm.app/",
    host: "romm.app",
    body: "Self-hosted ROM manager with a web interface. Manage your library from anywhere while keeping full control of your data on your own server.",
    tagsLabel: "Features",
    tags: ["Self-hosted", "Web UI", "Metadata", "Multi-user"],
    note: "Your collection lives on your hardware, full privacy.",
  },
  {
    name: "RetroAchievements",
    img: "/providers/retroachievements.svg",
    role: "Achievements",
    url: "https://retroachievements.org",
    host: "retroachievements.org",
    body: "The community achievement system for classic games. Log in with your account and unlock trophies right inside NeoStation.",
    tagsLabel: "Features",
    tags: ["Login in-app", "Progress tracking", "Leaderboards"],
    note: "Systems without RA support are hidden automatically.",
    wiki: "https://wiki.neostation.dev/features/retroachievements/",
  },
  {
    name: "ScreenScraper",
    img: "/providers/screenscraper.svg",
    role: "Metadata",
    url: "https://www.screenscraper.fr",
    host: "screenscraper.fr",
    body: "The largest community game database in emulation. Box art, screenshots, descriptions and release dates, scraped automatically for your whole library.",
    tagsLabel: "Features",
    tags: ["Batch scraping", "Box art", "Real game names"],
    note: "Raw ROM filenames become real game names in the UI.",
    wiki: "https://wiki.neostation.dev/features/scraping-and-metadata/",
  },
  {
    name: "RetroArch",
    img: "/providers/retroarch.svg",
    role: "Emulation",
    url: "https://www.retroarch.com",
    host: "retroarch.com",
    body: "The multi-system emulator frontend at the heart of the retro scene. NeoStation pairs with RetroArch for emulation and deeply integrates its save and state system.",
    tagsLabel: "Features",
    tags: ["LibRetro cores", "Save states", "SRAM saves", "Cross-platform"],
    note: "Cloud saves, achievements and scraping are all built on RetroArch data.",
    wiki: "https://wiki.neostation.dev/configuration/configuring-emulators/",
  },
];

const wikiPages = [
  { href: "/getting-started/getting-started/", title: "Getting started", body: "Add a ROM folder, scan it and choose an emulator." },
  { href: "/library/adding-your-games/", title: "Adding your games", body: "ROM folders, subfolders, rescans and Android storage access." },
  { href: "/library/multi-disc-games/", title: "Multi-disc games", body: "Group disc sets into folders with .m3u playlists automatically." },
  { href: "/configuration/configuring-emulators/", title: "Configuring emulators", body: "RetroArch cores, standalone executables, PS3 and native ports." },
  { href: "/features/neosync/", title: "NeoSync", body: "How saves are found, synced, listed and restored, and custom save folders." },
  { href: "/features/retroachievements/", title: "RetroAchievements", body: "Sign in, match your library, profiles, AOTW and leaderboards." },
  { href: "/features/scraping-and-metadata/", title: "Scraping & metadata", body: "Connect ScreenScraper and choose media, region and language." },
  { href: "/platforms/steam-deck-and-steamos/", title: "Steam Deck & SteamOS", body: "Run the AppImage through Steam for proper controller input." },
  { href: "/troubleshooting/", title: "Troubleshooting", body: "Games missing, launches failing, scraping or sync problems." },
  { href: "/faqs/", title: "FAQs", body: "Themes, scrapers, social features and other common questions." },
];

const h2 = "heading mt-6 text-h2";
const h3 = "text-h3 font-bold leading-[1.2] tracking-[-0.01em]";
const prose = "max-w-[40rem] text-bone-2 leading-[1.65]";
const link = "text-bone underline decoration-bone-3 underline-offset-4 transition-colors hover:decoration-bone";
const code = "rounded-md bg-ink-3 px-1.5 py-0.5 font-mono text-[0.875em] text-bone";
---
<PageLayout meta={meta}>
  <!-- Hero -->
  <PageHero
    label="Complete manual"
    title="User guide."
    lead="Master your experience with NeoStation. From basic setup to fine-tuning cloud saves, this manual has you covered."
  >
    <dl class="mt-12 grid grid-cols-3 border-y border-line">
      <div class="py-5 pr-4">
        <dt class="label">Systems supported</dt>
        <dd class="mt-2 font-mono text-2xl font-semibold text-bone">{emulationCompatibleCount}</dd>
      </div>
      <div class="border-l border-line py-5 pl-4 md:pl-6">
        <dt class="label">NeoSync ready</dt>
        <dd class="mt-2 font-mono text-2xl font-semibold text-bone">{neosyncCompatibleCount}</dd>
      </div>
      <div class="border-l border-line py-5 pl-4 md:pl-6">
        <dt class="label">Systems tracked</dt>
        <dd class="mt-2 font-mono text-2xl font-semibold text-bone">{totalSystems}</dd>
      </div>
    </dl>
  </PageHero>

  <div class="mx-auto max-w-[76rem] px-5 pb-22 md:px-8 lg:pb-32">
    <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
      <!-- Table of contents -->
      <aside class="pt-10 lg:pt-16">
        <!-- Mobile: collapsible -->
        <details class="toc-mobile rounded-2xl border border-line bg-ink-2 lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4">
            <span class="label">On this page</span>
            <Icon name="heroicons:chevron-down" class="toc-chevron h-4 w-4 text-bone-3 transition-transform" aria-hidden="true" />
          </summary>
          <ol class="border-t border-line px-5 py-2">
            {toc.map((item, i) => (
              <li>
                <a href={`#${item.id}`} class="flex items-baseline gap-4 py-2.5 text-bone-2 hover:text-bone">
                  <span class="font-mono text-xs text-bone-3">{String(i + 1).padStart(2, "0")}</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </details>

        <!-- Desktop: sticky -->
        <nav class="sticky top-28 hidden lg:block" aria-label="On this page">
          <p class="label">On this page</p>
          <ol class="mt-4 border-l border-line">
            {toc.map((item, i) => (
              <li>
                <a href={`#${item.id}`} class="toc-link flex items-baseline gap-3 py-2 pl-4 text-[0.9375rem] text-bone-3 transition-colors hover:text-bone" data-toc={item.id}>
                  <span class="font-mono text-xs">{String(i + 1).padStart(2, "0")}</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
          <div class="mt-10 border-t border-line pt-5">
            <p class="text-sm text-bone-3">Need more help? Join our community.</p>
            <a href="https://discord.gg/xE2kgKsRVq" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm mt-3">
              <Icon name="simple-icons:discord" class="h-4 w-4" aria-hidden="true" />
              Discord server
            </a>
            <a href="https://wiki.neostation.dev/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm mt-2">
              <Icon name="heroicons:book-open" class="h-4 w-4" aria-hidden="true" />
              Wiki
            </a>
          </div>
        </nav>
      </aside>

      <!-- Content -->
      <div class="min-w-0">
        <!-- Getting Started -->
        <section id="getting-started" class="scroll-mt-24 pt-16 lg:pt-16">
          <p class="label section-label">01 · Start</p>
          <h2 class={h2}>Getting started</h2>
          <ol class="mt-10 max-w-[40rem] border-t border-line">
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-5">
              <span class="font-mono text-sm text-start">01</span>
              <div>
                <h3 class="font-semibold text-bone">Download</h3>
                <p class="mt-1 text-bone-2">Get the application from the <a href="/downloads/" class={link}>downloads page</a>.</p>
              </div>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-5">
              <span class="font-mono text-sm text-start">02</span>
              <div>
                <h3 class="font-semibold text-bone">Install</h3>
                <p class="mt-1 text-bone-2">Install the app on your device following the <a href="#installation" class={link}>platform-specific steps</a>.</p>
              </div>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-5">
              <span class="font-mono text-sm text-start">03</span>
              <div>
                <h3 class="font-semibold text-bone">Add your ROMs</h3>
                <p class="mt-1 text-bone-2">Open <strong class="font-semibold text-bone">Settings → Directories → Add ROM Folder</strong> and pick the folder that holds your games, organised in the <a href="#folder-compatibility" class={link}>standard structure</a>. You can add up to five folders; use <strong class="font-semibold text-bone">Rescan All ROM Folders</strong> after adding files.</p>
              </div>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-5">
              <span class="font-mono text-sm text-start">04</span>
              <div>
                <h3 class="font-semibold text-bone">Play</h3>
                <p class="mt-1 text-bone-2">Open a system, choose its emulator, select a game and press A. NeoStation launches RetroArch or the standalone emulator you picked; emulators are installed separately.</p>
              </div>
            </li>
          </ol>
        </section>

        <!-- Installation -->
        <section id="installation" class="scroll-mt-24 pt-16 lg:pt-20">
          <p class="label section-label">02 · Install</p>
          <h2 class={h2}>Installation</h2>

          <div class="mt-10 border-t border-line">
            <!-- Windows -->
            <article class="grid gap-x-8 gap-y-3 border-b border-line py-8 md:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="flex items-center gap-3 md:items-start">
                <Icon name="simple-icons:windows" class="h-5 w-5 shrink-0 text-bone-2 md:mt-1" aria-hidden="true" />
                <div>
                  <h3 class={h3}>Windows</h3>
                  <p class="label mt-1">ZIP · portable</p>
                </div>
              </div>
              <div class="max-w-[40rem]">
                <p class="text-bone-2">Simple and portable. No installer needed.</p>
                <p class="mt-3 text-bone-2">Unzip the ZIP file into a folder and run <code class={code}>neostation.exe</code>.</p>
              </div>
            </article>

            <!-- Android -->
            <article class="grid gap-x-8 gap-y-3 border-b border-line py-8 md:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="flex items-center gap-3 md:items-start">
                <Icon name="simple-icons:android" class="h-5 w-5 shrink-0 text-bone-2 md:mt-1" aria-hidden="true" />
                <div>
                  <h3 class={h3}>Android</h3>
                  <p class="label mt-1">APK</p>
                </div>
              </div>
              <div class="max-w-[40rem]">
                <p class="text-bone-2">Optimized for touch and handheld screens.</p>
                <p class="mt-3 text-bone-2">Install the APK manually from our <a href="/downloads/" class={link}>downloads page</a>.</p>
                <div class="mt-5 rounded-2xl border border-line bg-ink-2 px-5 py-4" role="note">
                  <p class="label text-red">Important</p>
                  <p class="mt-1.5 text-[0.9375rem] text-bone-2">On Android 11+, you must enable "All Files Access" in settings to manage games.</p>
                </div>
              </div>
            </article>

            <!-- Linux -->
            <article class="grid gap-x-8 gap-y-3 border-b border-line py-8 md:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="flex items-center gap-3 md:items-start">
                <Icon name="simple-icons:linux" class="h-5 w-5 shrink-0 text-bone-2 md:mt-1" aria-hidden="true" />
                <div>
                  <h3 class={h3}>Linux</h3>
                  <p class="label mt-1">AppImage</p>
                </div>
              </div>
              <div class="max-w-[40rem]">
                <p class="text-bone-2">Universal AppImage support.</p>
                <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-ink-2 px-5 py-4 font-mono text-sm text-bone"><code><span class="select-none text-bone-3">$ </span>chmod +x NeoStation-Linux.AppImage</code></pre>
                <p class="mt-3 text-bone-2">Make the file executable and run it via terminal or file manager.</p>
                <div class="mt-5 rounded-2xl border border-line bg-ink-2 px-5 py-4" role="note">
                  <p class="label">Steam Deck</p>
                  <p class="mt-1.5 text-[0.9375rem] text-bone-2">Add the x86_64 AppImage to Steam with <strong class="font-semibold text-bone">Games → Add a Non-Steam Game</strong> and launch it from Steam, so the controller works properly. <a href="https://wiki.neostation.dev/platforms/steam-deck-and-steamos/" target="_blank" rel="noopener noreferrer" class={link}>Full steps in the wiki</a>.</p>
                </div>
              </div>
            </article>

            <!-- macOS -->
            <article class="grid gap-x-8 gap-y-3 border-b border-line py-8 md:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="flex items-center gap-3 md:items-start">
                <Icon name="simple-icons:apple" class="h-5 w-5 shrink-0 text-bone-2 md:mt-1" aria-hidden="true" />
                <div>
                  <h3 class={h3}>macOS</h3>
                  <p class="label mt-1">DMG · Intel + Apple silicon</p>
                </div>
              </div>
              <div class="max-w-[40rem]">
                <p class="text-bone-2">Native DMG for Intel and Apple silicon, signed with an Apple Developer ID.</p>
              </div>
            </article>
          </div>
        </section>

        <!-- Setup & Configuration -->
        <section id="setup-configuration" class="scroll-mt-24 pt-16 lg:pt-20">
          <p class="label section-label">03 · Configure</p>
          <h2 class={h2}>Setup &amp; configuration</h2>

          <!-- ROMs structure -->
          <div class="mt-10 grid gap-8 border-t border-line pt-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
            <div>
              <h3 class={h3}>ROMs folder structure</h3>
              <p class:list={[prose, "mt-3"]}>
                Your ROMs folder must contain subfolders organized by system (e.g. <code class={code}>nes</code>,
                <code class={code}>snes</code>). NeoStation auto-detects these based on the standard naming convention.
              </p>
              <a href="#folder-compatibility" class="btn btn-ghost btn-sm mt-5">
                View all folder names
                <Icon name="heroicons:arrow-down" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
            <div class="screen self-start">
              <img src="/guide/guide-01.webp" alt="Example ROMs folder with one subfolder per system" class="block h-auto w-full" width="723" height="392" loading="lazy" />
            </div>
          </div>

          <!-- RetroArch Android -->
          <div class="mt-10 border-t border-line pt-8">
            <h3 class={h3}>RetroArch (Android) version</h3>
            <div class="mt-4 max-w-[40rem] rounded-2xl border border-line bg-ink-2 px-5 py-4" role="note">
              <p class="label text-red">Warning</p>
              <p class="mt-1.5 text-bone-2">
                For NeoSync to work on Android, <strong class="font-semibold text-bone">do not use the Play Store version</strong>.
                It has file restrictions that block cloud saves.
                <strong class="font-semibold text-bone">Use the version direct from <a href="https://retroarch.com/?page=platforms" target="_blank" rel="noopener noreferrer" class={link}>retroarch.com</a></strong>.
              </p>
            </div>
            <div class="mt-3 max-w-[40rem] rounded-2xl border border-line bg-ink-2 px-5 py-4" role="note">
              <p class="label">Tip</p>
              <p class="mt-1.5 text-[0.9375rem] text-bone-2">Back up your saves before switching! Place them in <code class={code}>/RetroArch/saves</code>.</p>
            </div>
          </div>

          <!-- Desktop binary -->
          <div class="mt-10 grid gap-8 border-t border-line pt-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
            <div>
              <h3 class={h3}>Desktop binary setup</h3>
              <p class:list={[prose, "mt-3"]}>
                On Windows, macOS and Linux, point NeoStation at each emulator once: open
                <strong class="font-semibold text-bone">Settings → Emulators → Standalone Emulators</strong>, pick the system and the
                emulator, and select its executable (e.g. <code class={code}>retroarch.exe</code>). On Android the emulator app is
                opened directly, with no executable to pick.
              </p>
              <a href="https://wiki.neostation.dev/configuration/configuring-emulators/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm mt-5">
                Configuring emulators in the wiki
                <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-label="opens in a new tab" />
              </a>
            </div>
            <div class="screen self-start">
              <img src="/guide/guide-03.webp" alt="System settings with the Emulators tab open and RetroArch selected" class="block h-auto w-full" loading="lazy" />
            </div>
          </div>
        </section>

        <!-- Integrations -->
        <section id="neosync" class="scroll-mt-24 pt-16 lg:pt-20">
          <p class="label section-label">04 · Connect</p>
          <h2 class={h2}>Integrations</h2>
          <p class:list={[prose, "mt-5"]}>
            NeoStation plugs directly into the services powering the modern emulation scene. Every integration works out
            of the box.
          </p>

          <ul class="mt-10 border-t border-line">
            {integrations.map((i) => (
              <li class="grid gap-x-8 gap-y-4 border-b border-line py-8 md:grid-cols-[12rem_minmax(0,1fr)]">
                <div class="flex items-center gap-3 md:flex-col md:items-start">
                  <img src={i.img} alt="" class="h-10 w-10 shrink-0 object-contain" width="40" height="40" loading="lazy" />
                  <div>
                    <h3 class={h3}>{i.name}</h3>
                    <p class="label mt-1">{i.role}</p>
                  </div>
                </div>
                <div class="max-w-[40rem]">
                  <p class="text-bone-2">{i.body}</p>
                  <dl class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                    <dt class="label">{i.tagsLabel}</dt>
                    <dd class="font-mono text-xs leading-[1.4] text-bone-2">{i.tags.join(" · ")}</dd>
                  </dl>
                  <p class="mt-3 text-[0.9375rem] text-bone-3">{i.note}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    <a href={i.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
                      {i.host}
                      <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-label="opens in a new tab" />
                    </a>
                    {i.wiki && (
                      <a href={i.wiki} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
                        Setup in the wiki
                        <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-label="opens in a new tab" />
                      </a>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Folder compatibility -->
        <section id="folder-compatibility" class="scroll-mt-24 pt-16 lg:pt-20">
          <p class="label section-label">05 · Folders</p>
          <h2 class={h2}>Folder structure</h2>
          <p class:list={[prose, "mt-5"]}>
            Automatically generated from system metadata. NeoStation auto-detects folders by these standard names.
          </p>
          <p class="label mt-4">Systems data v{systemsVersion} · {totalSystems} systems</p>

          <div class="mt-8 flex flex-col gap-4">
            <label class="flex h-11 items-center gap-3 rounded-full border border-line bg-ink-2 px-4 transition-colors focus-within:border-bone-3">
              <Icon name="heroicons:magnifying-glass" class="h-4 w-4 shrink-0 text-bone-3" aria-hidden="true" />
              <span class="sr-only">Search systems</span>
              <input
                id="system-search"
                type="text"
                class="w-full min-w-0 bg-transparent text-[0.9375rem] text-bone outline-none placeholder:text-bone-3"
                placeholder="Search systems…"
                autocomplete="off"
              />
            </label>
            <div class="flex flex-wrap gap-2" id="system-type-filters" role="group" aria-label="Filter by system type">
              <button type="button" data-type="all" class="type-filter is-active" aria-pressed="true">All</button>
              {systemTypes.map(([key, t]) => (
                <button type="button" data-type={key} class="type-filter" aria-pressed="false">
                  <Icon name={t.icon} class="h-3.5 w-3.5" aria-hidden="true" />
                  {t.label}
                </button>
              ))}
            </div>
          </div>

          <div class="mt-6 max-h-[32rem] overflow-auto rounded-2xl border border-line">
            <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
              <thead class="sticky top-0 z-10 bg-ink-2">
                <tr>
                  <th scope="col" class="label w-[40%] border-b border-line px-4 py-3 font-medium">System</th>
                  <th scope="col" class="label border-b border-line px-4 py-3 font-medium">Folders</th>
                  <th scope="col" class="label hidden border-b border-line px-4 py-3 font-medium md:table-cell">Extensions</th>
                </tr>
              </thead>
              <tbody>
                {
                  sortedSystems.map((s) => {
                    const type = s.system.details?.type ?? "console";
                    const t = systemTypeMeta[type] ?? { label: "Console", icon: "mdi:television-classic" };
                    return (
                      <tr data-system data-name={(s.system.name || "").toLowerCase()} data-type={type} class="border-t border-line transition-colors first:border-t-0 hover:bg-ink-2">
                        <td class="px-4 py-2.5 align-top">
                          <div class="flex items-start gap-3">
                            <Icon name={t.icon} class="mt-0.5 h-4 w-4 shrink-0 text-bone-3" aria-label={t.label} />
                            <div class="min-w-0">
                              <div class="font-semibold leading-tight text-bone">{s.system.name}</div>
                              <div class="mt-0.5 text-xs text-bone-3">{s.system.details?.manufacturer ?? "N/A"}</div>
                            </div>
                          </div>
                        </td>
                        <td class="px-4 py-2.5 align-top">
                          <div class="font-mono text-xs leading-relaxed text-bone">
                            {s.system.folders.join(", ")}
                          </div>
                        </td>
                        <td class="hidden px-4 py-2.5 align-top md:table-cell">
                          <div class="font-mono text-xs leading-relaxed text-bone-3">
                            {s.system.extensions?.map((e: string) => `.${e}`).join("  ") ?? "N/A"}
                          </div>
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>

          <p class="mt-4 font-mono text-xs text-bone-3" id="system-results-count" aria-live="polite">
            Showing {totalSystems} systems
          </p>
        </section>

        <!-- Wiki -->
        <section id="wiki" class="scroll-mt-24 pt-16 lg:pt-20">
          <p class="label section-label">06 · Wiki</p>
          <h2 class={h2}>Go deeper in the wiki</h2>
          <p class:list={[prose, "mt-5"]}>
            This guide covers the essentials. The NeoStation wiki lives next to the source code and is updated with
            every release, with step-by-step pages for each feature.
          </p>
          <ul class="mt-10 grid border-t border-line md:grid-cols-2">
            {wikiPages.map((w, n) => (
              <li class:list={["border-b border-line", n % 2 === 0 && "md:border-r md:pr-6", n % 2 === 1 && "md:pl-6"]}>
                <a href={`https://wiki.neostation.dev${w.href}`} target="_blank" rel="noopener noreferrer" class="group flex items-start justify-between gap-4 py-5">
                  <span>
                    <span class="block font-semibold text-bone">{w.title}</span>
                    <span class="mt-1 block text-[0.9375rem] text-bone-2">{w.body}</span>
                  </span>
                  <Icon name="heroicons:arrow-up-right" class="mt-1 h-4 w-4 shrink-0 text-bone-3 transition-colors group-hover:text-bone" aria-label="opens in a new tab" />
                </a>
              </li>
            ))}
          </ul>
          <a href="https://wiki.neostation.dev/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary mt-8">
            Open wiki.neostation.dev
            <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </section>

        <!-- Help (mobile; desktop has it in the sidebar) -->
        <div class="mt-16 border-t border-line pt-6 lg:hidden">
          <p class="text-sm text-bone-3">Need more help? Join our community.</p>
          <a href="https://discord.gg/xE2kgKsRVq" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm mt-3">
            <Icon name="simple-icons:discord" class="h-4 w-4" aria-hidden="true" />
            Discord server
          </a>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  /* Table of contents: the current section gets a small Start-red bar on the rule */
  .toc-link {
    position: relative;
    margin-left: -1px;
    border-left: 1px solid transparent;
  }
  .toc-link[aria-current="true"] {
    color: var(--color-bone);
  }
  .toc-link[aria-current="true"]::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 50%;
    width: 2px;
    height: 1.25rem;
    transform: translateY(-50%);
    border-radius: 2px;
    background: var(--color-start);
  }

  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile[open] .toc-chevron {
    transform: rotate(180deg);
  }

  /* Type filters: small pills, the active one is bone-filled */
  .type-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.875rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    color: var(--color-bone-2);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .type-filter:hover {
    color: var(--color-bone);
    border-color: var(--color-bone-3);
    background-color: var(--color-ink-3);
  }
  .type-filter.is-active {
    background-color: var(--color-bone);
    border-color: var(--color-bone);
    color: var(--color-ink);
  }
</style>

<script>
  // Compatibility table: search and type filters
  const searchInput = document.getElementById("system-search") as HTMLInputElement | null;
  const typeButtons = document.querySelectorAll<HTMLButtonElement>("#system-type-filters button");
  const rows = document.querySelectorAll<HTMLElement>("#folder-compatibility tbody tr[data-system]");
  const resultsCount = document.getElementById("system-results-count");
  let activeType = "all";

  if (searchInput && rows.length > 0) {
    const applyFilters = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const name = row.getAttribute("data-name") ?? "";
        const type = row.getAttribute("data-type") ?? "console";
        const matchesType = activeType === "all" || type === activeType;
        const matchesQuery = name.includes(query);
        const show = matchesType && matchesQuery;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (resultsCount) {
        resultsCount.textContent = `Showing ${visible} of ${rows.length} systems`;
      }
    };

    searchInput.addEventListener("input", applyFilters);

    typeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        typeButtons.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-pressed", "true");
        activeType = btn.getAttribute("data-type") ?? "all";
        applyFilters();
      });
    });
  }

  // Table of contents: mark the section being read
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>("[data-toc]");
  const sections = [...tocLinks]
    .map((a) => document.getElementById(a.dataset.toc ?? ""))
    .filter((s): s is HTMLElement => s !== null);

  if (sections.length > 0) {
    const setCurrent = () => {
      const line = window.innerHeight * 0.3;
      let current = sections[0]!.id;
      for (const s of sections) {
        if (s.getBoundingClientRect().top <= line) current = s.id;
      }
      // At the bottom of the page the last section is the current one
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = sections[sections.length - 1]!.id;
      }
      tocLinks.forEach((a) => {
        if (a.dataset.toc === current) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          setCurrent();
          ticking = false;
        });
      },
      { passive: true },
    );
    setCurrent();
  }
</script>
