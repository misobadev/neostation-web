---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
  description:
    "NeoStation is the free, open-source retro gaming frontend with nothing to set up: pick your ROMs folder and play, on Windows, Android, macOS and Linux.",
  title: "Pick your ROMs. That's it.",
};

// Same source as the guide's compatibility table
const systemsDir = path.resolve("./public/systems");
const systems = fs
  .readdirSync(systemsDir)
  .filter((f) => f.endsWith(".json") && !["all.json", "android.json", "manifest.json"].includes(f))
  .map((f) => JSON.parse(fs.readFileSync(path.join(systemsDir, f), "utf-8")));
const systemCount = systems.length;


const platforms = [
  { name: "Windows", icon: "simple-icons:windows", note: "10 / 11 · x64" },
  { name: "Android", icon: "simple-icons:android", note: "7.0+ · APK" },
  { name: "macOS", icon: "simple-icons:apple", note: "Intel + Apple silicon" },
  { name: "Linux", icon: "simple-icons:linux", note: "AppImage · x64 / ARM64" },
];

const slides = [
  // Shots from a 4:3 handheld; `wide` marks a 16:9 one, shown whole.
  { src: "/screenshots/neostation-01.webp?v=20261121", caption: "Carousel view", wide: false },
  { src: "/screenshots/neostation-03.webp?v=20261121", caption: "Every system on one screen", wide: false },
  { src: "/screenshots/neostation-02.webp?v=20261121", caption: "Game list with artwork, achievements and the Play prompt", wide: false },
  { src: "/screenshots/neostation-04.webp?v=20261121", caption: "RetroAchievements for each game", wide: false },
  { src: "/screenshots/neostation-11.webp?v=20261121", caption: "Your RetroAchievements profile, unlocks and awards", wide: false },
  { src: "/screenshots/neostation-05.webp?v=20261121", caption: "Themes: the app comes in many colours", wide: false },
  { src: "/screenshots/neostation-12.webp?v=20261121", caption: "Pick a theme, then tune the glass and the corners", wide: false },
  { src: "/screenshots/neostation-13.webp?v=20261121", caption: "System art packs made by the community", wide: false },
  { src: "/screenshots/neostation-09.webp?v=20261121", caption: "Scraping box art and metadata", wide: false },
  { src: "/screenshots/neostation-07.webp?v=20261121", caption: "Cloud saves with NeoSync", wide: false },
];

const steps = [
  {
    n: "01",
    title: "Pick your ROMs folder",
    body: "One folder with a subfolder per system, the layout most collections already use.",
  },
  {
    n: "02",
    title: "Let it scan",
    body: `NeoStation detects ${systemCount} systems, then fetches box art, descriptions and ratings for every game.`,
  },
  {
    n: "03",
    title: "Press A",
    body: "Games open in RetroArch or the standalone emulator you choose for each system.",
  },
];

const controls = [
  { keys: ["A"], action: "Play the selected game" },
  { keys: ["B"], action: "Go back" },
  { keys: ["Y"], action: "Add to favourites" },
  { keys: ["X"], action: "Change the view" },
  { keys: ["LB", "RB"], action: "Switch between library, artwork, achievements and settings" },
];

// Tells search engines what NeoStation is. No version number, so it never goes stale.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "NeoStation",
  description: meta.description,
  url: "https://neostation.dev/",
  applicationCategory: "GameApplication",
  operatingSystem: "Windows, Android, macOS, Linux",
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: "https://neostation.dev/downloads/",
  screenshot: "https://neostation.dev/og-image.png",
  sameAs: ["https://github.com/misobadev/neostation-frontend"],
};

const integrations = [
  { name: "NeoSync", img: "/providers/neosync.svg", url: "https://neosync.cloud", role: "Cloud saves", body: "Saves and states follow you between Windows, Android, macOS and Linux." },
  { name: "RetroAchievements", img: "/providers/retroachievements.svg", url: "https://retroachievements.org", role: "Achievements", body: "Sign in once and see your progress for each game, in the game list." },
  { name: "ScreenScraper", img: "/providers/screenscraper.svg", url: "https://www.screenscraper.fr", role: "Metadata", body: "Box art, screenshots, descriptions and ratings, fetched while you scan." },
  { name: "RomM", img: "/providers/romm.svg", url: "https://romm.app/", role: "ROM manager", body: "Browse and download from your self-hosted RomM library." },
  { name: "RetroArch", img: "/providers/retroarch.svg", url: "https://www.retroarch.com", role: "Emulation", body: "Launches cores directly, alongside standalone emulators." },
  { name: "NeoAssets", img: "/providers/neoassets.svg", url: "https://neoassets.dev", role: "Art and metadata", body: "Community system art packs and game metadata, shared and reviewed on neoassets.dev.", soon: true },
];
---

<PageLayout meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- Hero -->
  <section class="mx-auto max-w-[76rem] px-5 pt-12 md:px-8 md:pt-16">
    <!-- Text beside the screen on wide displays, so the whole screenshot is in view with the pitch -->
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="lg:col-span-5">
        <p class="label">All platforms</p>
        <h1 class="display mt-5 text-display">Pick your ROMs. That's it.</h1>
        <p class="mt-6 max-w-[36rem] text-lead text-bone-2">
          No config files and no emulator paths to fill in. Choose your ROMs folder and NeoStation finds your
          systems, fetches the artwork and is ready to play.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/downloads/" class="btn btn-primary btn-lg pl-2">
            <span class="pad bg-ink text-start" aria-hidden="true">A</span>
            Download for free
          </a>
          <a href="/guide/" class="btn btn-secondary btn-lg">Read the guide</a>
          <span class="label ml-1">Free · GPL-3.0</span>
        </div>
      </div>

      <!-- Screen with LB / RB switcher -->
      <figure class="lg:col-span-7" data-slider>
        <div class="screen relative aspect-[4/3]">
          {slides.map((s, i) => (
            <img
              src={s.src}
              alt={s.caption}
              width={s.wide ? 1920 : 1280}
              height={s.wide ? 1080 : 960}
              class:list={["absolute inset-0 h-full w-full transition-opacity duration-300", s.wide ? "object-contain" : "object-cover", i === 0 ? "opacity-100" : "opacity-0"]}
              loading={i === 0 ? "eager" : "lazy"}
              data-slide={i}
              aria-hidden={i === 0 ? undefined : "true"}
            />
          ))}
        </div>
        <figcaption class="mt-4 flex items-center justify-between gap-4">
          <span class="text-[0.9375rem] text-bone-2" data-caption aria-live="polite">{slides[0]!.caption}</span>
          <span class="flex shrink-0 items-center gap-2">
            <button type="button" class="pad h-9 min-w-12 cursor-pointer transition-colors hover:bg-line" data-prev aria-label="Previous screenshot">LB</button>
            <span class="label w-16 whitespace-nowrap text-center tabular-nums" data-count>1 / {slides.length}</span>
            <button type="button" class="pad h-9 min-w-12 cursor-pointer transition-colors hover:bg-line" data-next aria-label="Next screenshot">RB</button>
          </span>
        </figcaption>
      </figure>
    </div>

    <!-- Platforms -->
    <ul class="mt-14 grid grid-cols-2 border-y border-line md:grid-cols-4">
      {platforms.map((p, i) => (
        <li class:list={["flex items-center gap-3 py-5 md:px-5", i % 2 === 1 && "pl-4 border-l border-line", i > 0 && "md:border-l md:border-line", i === 0 && "md:pl-0", i > 1 && "border-t border-line md:border-t-0"]}>
          <Icon name={p.icon} class="h-5 w-5 shrink-0 text-bone-2" aria-hidden="true" />
          <span>
            <span class="block font-semibold">{p.name}</span>
            <span class="block font-mono text-xs text-bone-3">{p.note}</span>
          </span>
        </li>
      ))}
    </ul>

    <!-- Support: NeoStation is free and is kept going by the people who use it -->
    <aside class="mt-10 grid gap-6 rounded-2xl border border-line bg-ink-2 p-6 md:p-8 lg:grid-cols-12 lg:items-center" aria-labelledby="support-title">
      <div class="flex gap-5 lg:col-span-7">
        <Icon name="heroicons:heart" class="mt-1 h-6 w-6 shrink-0 text-start" aria-hidden="true" />
        <div>
          <h2 id="support-title" class="text-h3 font-bold">Free and open source, kept going by its players.</h2>
          <p class="mt-2 max-w-[38rem] text-bone-2">
            NeoStation has no ads and no paywall. If you enjoy it, a donation on Patreon goes a long way: it pays for
            the servers and the time to keep improving it. Sharing it with your friends helps just as much.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href="https://www.patreon.com/cw/NeoStation" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
          <Icon name="simple-icons:patreon" class="h-4 w-4" aria-hidden="true" />Support on Patreon
        </a>
        <button type="button" class="btn btn-ghost btn-lg cursor-pointer" data-share>
          <Icon name="heroicons:share" class="h-5 w-5" aria-hidden="true" /><span data-share-label>Share NeoStation</span>
        </button>
      </div>
    </aside>
  </section>

  <!-- Setup -->
  <section class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
    <p class="label section-label">Set up</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-12">
      <h2 class="heading text-h2 lg:col-span-7">Point it at your ROMs. That is the whole setup.</h2>
    </div>
    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {steps.map((s) => (
        <li class="border-t border-bone-3 pt-5">
          <span class="font-mono text-sm text-start">{s.n}</span>
          <h3 class="mt-3 text-h3 font-bold leading-tight tracking-[-0.01em]">{s.title}</h3>
          <p class="mt-2 max-w-[36ch] text-bone-2">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-14 grid gap-4 md:grid-cols-2">
      <div class="screen aspect-[4/3]">
        <img src="/screenshots/roms-folder.webp?v=20261121" alt="Choosing the ROMs folder on Android, one subfolder per system" class="h-full w-full object-cover" loading="lazy" width="1280" height="960" />
      </div>
      <div class="screen aspect-[4/3]">
        <img src="/screenshots/neostation-03.webp?v=20261121" alt="The same collection in NeoStation, one card per system" class="h-full w-full object-cover object-top" loading="lazy" width="1280" height="960" />
      </div>
    </div>
    <p class="mt-4 text-sm text-bone-3">
      Folder names for each system are in the <a href="/guide/#folder-compatibility" class="text-bone-2 underline decoration-bone-3 underline-offset-4 hover:text-bone">compatibility table</a>.
    </p>
  </section>

  <!-- Controller -->
  <section class="border-y border-line bg-ink-2">
    <div class="mx-auto grid max-w-[76rem] gap-12 px-5 py-16 md:px-8 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <p class="label section-label">Controller first</p>
        <h2 class="heading mt-6 text-h2">Made for the couch, not the desk.</h2>
        <p class="mt-5 max-w-[36rem] text-bone-2">
          Every screen works with a gamepad, and the buttons do the same thing everywhere. Keyboard, mouse and touch work
          too.
        </p>
        <dl class="mt-10 border-t border-line">
          {controls.map((c) => (
            <div class="flex items-center gap-5 border-b border-line py-3.5">
              <dt class="flex w-24 shrink-0 gap-1.5">
                {c.keys.map((k) => <kbd class:list={["pad", k === "A" && "bg-start text-ink"]}>{k}</kbd>)}
              </dt>
              <dd class="text-[0.9375rem]">{c.action}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="lg:col-span-7 lg:pt-14">
        <div class="screen aspect-[4/3]">
          <img src="/screenshots/neostation-08.webp?v=20261121" alt="A game list, driven with the controller" class="h-full w-full object-cover" loading="lazy" width="1280" height="960" />
        </div>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div class="screen aspect-[4/3]">
            <img src="/screenshots/neostation-06.webp?v=20261121" alt="Box art for each game" class="h-full w-full object-cover" loading="lazy" width="1280" height="960" />
          </div>
          <div class="screen aspect-[4/3]">
            <img src="/screenshots/neostation-10.webp?v=20261121" alt="A light theme" class="h-full w-full object-cover" loading="lazy" width="1280" height="960" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Integrations -->
  <section class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
    <p class="label section-label">Integrations</p>
    <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2 class="heading max-w-[18ch] text-h2">Works with the services you already use.</h2>
      <a href="/integrations/" class="btn btn-secondary self-start lg:self-auto">
        How each one works
        <Icon name="heroicons:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
    <ul class="mt-12 border-t border-line">
      {integrations.map((i) => (
        <li>
          <a
            href={i.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-[2.5rem_1fr_auto] items-center gap-x-5 gap-y-1 border-b border-line py-5 transition-colors hover:bg-ink-2 md:grid-cols-[2.5rem_14rem_10rem_1fr_auto] md:px-3"
          >
            <img src={i.img} alt="" class="h-10 w-10 object-contain" width="40" height="40" loading="lazy" />
            <span class="flex items-center gap-2 font-semibold">
              {i.name}
              {i.soon && <span class="rounded-full border border-start/60 px-2 py-0.5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.08em] text-start">Soon</span>}
            </span>
            <span class="label hidden md:block">{i.role}</span>
            <span class="col-start-2 text-[0.9375rem] text-bone-2 md:col-start-auto">{i.body}</span>
            <Icon name="heroicons:arrow-up-right" class="row-start-1 col-start-3 h-4 w-4 text-bone-3 transition-colors group-hover:text-bone md:row-start-auto md:col-start-auto" aria-label="opens in a new tab" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Open source -->
  <section class="bg-start text-ink">
    <div class="mx-auto grid max-w-[76rem] gap-10 px-5 py-20 md:px-8 lg:grid-cols-12 lg:py-28">
      <div class="lg:col-span-7">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.08em]">Free and open source · GPL-3.0</p>
        <h2 class="heading mt-5 text-h2">Free to use, free to read, free to change.</h2>
        <p class="mt-5 max-w-[36rem] text-ink/80">
          NeoStation has no ads and no paywall, and every line is on GitHub. Read the code, report a bug, send a pull
          request, or help pay for the servers on Patreon.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:flex-col lg:items-stretch lg:justify-end">
        <a href="https://github.com/misobadev/neostation-frontend" target="_blank" rel="noopener noreferrer" class="btn btn-lg justify-between bg-ink text-bone hover:bg-ink-3">
          <span class="flex items-center gap-3"><Icon name="simple-icons:github" class="h-5 w-5" aria-hidden="true" />Source on GitHub</span>
          <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
        </a>
        <a href="https://discord.gg/xE2kgKsRVq" target="_blank" rel="noopener noreferrer" class="btn btn-lg justify-between border border-ink/40 text-ink hover:bg-ink/10">
          <span class="flex items-center gap-3"><Icon name="simple-icons:discord" class="h-5 w-5" aria-hidden="true" />Join the Discord</span>
          <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
        </a>
        <a href="https://www.patreon.com/cw/NeoStation" target="_blank" rel="noopener noreferrer" class="btn btn-lg justify-between border border-ink/40 text-ink hover:bg-ink/10">
          <span class="flex items-center gap-3"><Icon name="simple-icons:patreon" class="h-5 w-5" aria-hidden="true" />Support on Patreon</span>
          <Icon name="heroicons:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Share: the system share sheet where there is one, otherwise copy the link.
  function initShare() {
    const btn = document.querySelector<HTMLButtonElement>("[data-share]");
    const label = btn?.querySelector("[data-share-label]");
    if (!btn || !label) return;
    const data = { title: "NeoStation", text: "All your retro games on every screen you own. Free and open source.", url: "https://neostation.dev/" };
    btn.addEventListener("click", async () => {
      if (navigator.share) {
        try { await navigator.share(data); } catch { /* closed by the user */ }
        return;
      }
      try {
        await navigator.clipboard.writeText(data.url);
        label.textContent = "Link copied";
        setTimeout(() => (label.textContent = "Share NeoStation"), 2000);
      } catch { window.open(data.url, "_blank"); }
    });
  }
  initShare();

  function initSlider() {
    const root = document.querySelector<HTMLElement>("[data-slider]");
    if (!root) return;
    const slides = [...root.querySelectorAll<HTMLImageElement>("[data-slide]")];
    const caption = root.querySelector("[data-caption]");
    const count = root.querySelector("[data-count]");
    let current = 0;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((img, n) => {
        img.classList.toggle("opacity-100", n === current);
        img.classList.toggle("opacity-0", n !== current);
        if (n === current) img.removeAttribute("aria-hidden");
        else img.setAttribute("aria-hidden", "true");
      });
      if (caption) caption.textContent = slides[current]!.alt;
      if (count) count.textContent = `${current + 1} / ${slides.length}`;
    };

    root.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
    root.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  }

  initSlider();
</script>
