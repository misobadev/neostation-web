---
import { Icon } from "astro-icon/components";
import PageHero from "@/components/PageHero.astro";
import PageLayout from "@/layouts/Base.astro";
import type { SiteMeta } from "@/types";

const meta: SiteMeta = {
  description:
    "Download NeoStation for Windows, Android, Linux and macOS. Free and open source, with system requirements for each platform.",
  ogImage: "/ogImageBig.png",
  title: "Download",
  twitterCard: "summary",
  twitterImage: "/ogImageSmall.png",
};

const latestVersion = "Beta 0.7.4+89";
const releaseDate = "May 01, 2026";
const releaseUrl =
  "https://github.com/misobadev/neostation-frontend/releases/latest";

const windowsLink =
  "https://github.com/misobadev/neostation-frontend/releases/download/v0.7.4+89/neostation-windows-x64-0.7.4+89.zip";
const androidApkLink =
  "https://github.com/misobadev/neostation-frontend/releases/download/v0.7.4+89/neostation-android-arm64-v8a-0.7.4+89.apk";
const linuxX64Link =
  "https://github.com/misobadev/neostation-frontend/releases/download/v0.7.4+89/neostation-linux-x86_64-0.7.4+89.AppImage";
const linuxArm64Link =
  "https://github.com/misobadev/neostation-frontend/releases/download/v0.7.4+89/neostation-linux-arm64-0.7.4+89.AppImage";
const macosLink =
  "https://github.com/misobadev/neostation-frontend/releases/download/v0.7.4+89/neostation-macos-universal-0.7.4+89.dmg";

const platforms = [
  {
    name: "Windows",
    version: latestVersion,
    icon: "simple-icons:windows",
    requirements: "Windows 10 / 11 (64-bit)",
    link: windowsLink,
    label: "Download for Windows",
    dataKey: "windows",
    note: "Requires <a href='https://aka.ms/vs/17/release/vc_redist.x64.exe' target='_blank' rel='noopener noreferrer' class='text-bone-2 underline decoration-bone-3 underline-offset-4 hover:text-bone'>Microsoft Visual C++ Redistributable (x64)</a>.",
  },
  {
    name: "Android",
    version: latestVersion,
    icon: "simple-icons:android",
    requirements: "7.0+ (API 24+)",
    isAndroid: true,
    note: "Requires 'All Files Access' permission on Android 11+ to manage games and saves.",
    links: [
      {
        label: "Download APK",
        url: androidApkLink,
        primary: true,
        recommended: false,
        dataKey: "android-apk",
      },
      {
        label: "Get it on Obtainium",
        url: "https://apps.obtainium.imranr.dev/redirect?r=obtainium://app/%7B%22id%22%3A%22dev.misoba.neostation%22%2C%22url%22%3A%22https%3A%2F%2Fgithub.com%2Fmisobadev%2Fneostation-frontend%22%2C%22author%22%3A%22misobadev%22%2C%22name%22%3A%22NeoStation%22%2C%22preferredApkIndex%22%3A0%2C%22additionalSettings%22%3A%22%7B%5C%22includePrereleases%5C%22%3Afalse%2C%5C%22fallbackToOlderReleases%5C%22%3Atrue%2C%5C%22filterReleaseTitlesByRegEx%5C%22%3A%5C%22%5C%22%2C%5C%22filterReleaseNotesByRegEx%5C%22%3A%5C%22%5C%22%2C%5C%22verifyLatestTag%5C%22%3Afalse%2C%5C%22sortMethodChoice%5C%22%3A%5C%22date%5C%22%2C%5C%22useLatestAssetDateAsReleaseDate%5C%22%3Afalse%2C%5C%22releaseTitleAsVersion%5C%22%3Afalse%2C%5C%22trackOnly%5C%22%3Afalse%2C%5C%22versionExtractionRegEx%5C%22%3A%5C%22%5C%22%2C%5C%22matchGroupToUse%5C%22%3A%5C%22%5C%22%2C%5C%22versionDetection%5C%22%3Atrue%2C%5C%22releaseDateAsVersion%5C%22%3Afalse%2C%5C%22useVersionCodeAsOSVersion%5C%22%3Afalse%2C%5C%22apkFilterRegEx%5C%22%3A%5C%22%5C%22%2C%5C%22invertAPKFilter%5C%22%3Atrue%2C%5C%22autoApkFilterByArch%5C%22%3Atrue%2C%5C%22appName%5C%22%3A%5C%22%5C%22%2C%5C%22appAuthor%5C%22%3A%5C%22%5C%22%2C%5C%22shizukuPretendToBeGooglePlay%5C%22%3Afalse%2C%5C%22allowInsecure%5C%22%3Afalse%2C%5C%22exemptFromBackgroundUpdates%5C%22%3Afalse%2C%5C%22skipUpdateNotifications%5C%22%3Afalse%2C%5C%22about%5C%22%3A%5C%22%5C%22%2C%5C%22refreshBeforeDownload%5C%22%3Afalse%2C%5C%22includeZips%5C%22%3Afalse%2C%5C%22zippedApkFilterRegEx%5C%22%3A%5C%22%5C%22%7D%22%2C%22overrideSource%22%3Anull%7D",
        primary: false,
        recommended: false,
      },
    ],
  },
  {
    name: "Linux",
    version: latestVersion,
    icon: "simple-icons:linux",
    requirements: "AppImage (x86_64 / ARM64)",
    isLinux: true,
    links: [
      {
        label: "Download x64",
        url: linuxX64Link,
        primary: true,
        recommended: false,
        dataKey: "linux-x64",
      },
      {
        label: "Download ARM64",
        url: linuxArm64Link,
        primary: false,
        recommended: false,
        dataKey: "linux-arm64",
      },
    ],
  },
  {
    name: "macOS",
    version: latestVersion,
    icon: "simple-icons:apple",
    requirements: "Universal (Intel & Apple Silicon)",
    link: macosLink,
    label: "Download for macOS",
    dataKey: "macos",
    note: "If blocked by system, go to System Settings > Privacy & Security and click 'Open Anyway'.",
  },
];

const systemRequirements = [
  {
    platform: "Android",
    icon: "simple-icons:android",
    minCpu: "Cortex-A53 / A55 @ 1.5 GHz",
    cores: "4 Cores",
    minRam: "2 GB",
    recRam: "3–4 GB",
    minGpu: "Mali-G31 / Adreno 3xx",
    notes:
      "With 1 GB, the OS leaves ~400 MB free; the app requires more for stable performance.",
  },
  {
    platform: "Linux ARM64",
    icon: "simple-icons:linux",
    minCpu: "Cortex-A53 / A55 @ 1.5 GHz",
    cores: "4 Cores",
    minRam: "1.5 GB",
    recRam: "2 GB",
    minGpu: "GLES 3.0 / Vulkan",
    notes:
      "More viable than Android on 1 GB devices due to lower OS overhead.",
  },
  {
    platform: "Linux x64",
    icon: "simple-icons:linux",
    minCpu: "Intel Haswell / AMD Excavator",
    cores: "2 Cores",
    minRam: "2 GB",
    recRam: "4 GB",
    minGpu: "OpenGL 3.0+",
  },
  {
    platform: "macOS",
    icon: "simple-icons:apple",
    minCpu: "Intel i5 4th Gen / Apple M1",
    cores: "4 Cores",
    minRam: "4 GB",
    recRam: "8 GB",
    minGpu: "Integrated Intel / Apple Silicon",
    notes: "Rosetta translation increases resource consumption on Intel Macs.",
  },
  {
    platform: "Windows",
    icon: "simple-icons:windows",
    minCpu: "Intel i3 4th Gen / AMD FX",
    cores: "2 Cores",
    minRam: "4 GB",
    recRam: "8 GB",
    minGpu: "DirectX 11",
    notes: "Windows 10/11 typically consumes 2–3 GB of RAM on its own.",
  },
];
// File type for each platform, shown as a fact in the downloads list
const packages: Record<string, string> = {
  Windows: ".zip · x64",
  Android: ".apk · arm64-v8a",
  Linux: ".AppImage",
  macOS: ".dmg · universal",
};

// Default for the main button before the platform is detected
const defaultDownload = { key: "windows", label: "Download for Windows", url: windowsLink };

---

<PageLayout meta={meta}>
  <!-- Hero -->
  <PageHero
    label="Downloads · free and open source"
    title="Get NeoStation."
    lead="One release for Windows, Android, Linux and macOS. Download the file for your device, open it, and point NeoStation at your ROMs folder."
  >
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={defaultDownload.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg pl-2"
            data-primary-download={defaultDownload.key}
          >
            <span class="pad bg-ink text-start" aria-hidden="true">A</span>
            <span data-primary-label>{defaultDownload.label}</span>
          </a>
          <a href="#all-platforms" class="btn btn-secondary btn-lg">Other platforms</a>
        </div>
        <p class="mt-4 font-mono text-xs break-all text-bone-3" data-primary-file></p>

        <dl class="mt-10 grid max-w-[44rem] grid-cols-2 gap-x-8 gap-y-5 border-t border-line pt-6 sm:grid-cols-4">
          <div>
            <dt class="label">Version</dt>
            <dd class="mt-1.5 font-mono text-sm text-bone" data-release-version>{latestVersion}</dd>
          </div>
          <div>
            <dt class="label">Released</dt>
            <dd class="mt-1.5 font-mono text-sm text-bone" data-release-date>{releaseDate}</dd>
          </div>
          <div>
            <dt class="label">Channel</dt>
            <dd class="mt-1.5 font-mono text-sm text-bone">Stable beta</dd>
          </div>
          <div>
            <dt class="label">Notes</dt>
            <dd class="mt-1.5 font-mono text-sm">
              <a
                href={releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-release-badge
                class="inline-flex items-center gap-1.5 text-bone underline decoration-bone-3 underline-offset-4 hover:decoration-bone"
              >
                On GitHub
                <Icon name="heroicons:arrow-up-right" class="h-3.5 w-3.5" aria-label="opens in a new tab" />
              </a>
            </dd>
          </div>
        </dl>
  </PageHero>

  <!-- All platforms -->
  <section id="all-platforms" class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
    <p class="label section-label">All platforms</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-12">
      <h2 class="heading text-h2 lg:col-span-8">Every file in the release, for every device.</h2>
    </div>

    <div class="mt-12 hidden gap-x-6 border-b border-line pb-3 md:grid md:px-3 md:grid-cols-[11rem_minmax(0,1fr)_10rem_19rem]">
      <span class="label">Platform</span>
      <span class="label">Requirements</span>
      <span class="label">Package</span>
      <span class="label text-right">Download</span>
    </div>
    <ul class="mt-12 border-t border-line md:mt-0 md:border-t-0">
      {platforms.map((p) => {
        const links = p.links ?? [{ label: p.label!, url: p.link!, primary: true, dataKey: p.dataKey }];
        const keys = links.map((l) => l.dataKey).filter(Boolean).join(" ");
        return (
          <li class="border-b border-line py-6 md:px-3" data-platform-row={keys}>
            <div class="grid gap-x-6 gap-y-3 md:items-center md:grid-cols-[11rem_minmax(0,1fr)_10rem_19rem]">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <Icon name={p.icon} class="h-5 w-5 shrink-0 text-bone-2" aria-hidden="true" />
                <span class="text-[1.125rem] font-semibold">{p.name}</span>
                <span class="label hidden basis-full whitespace-nowrap pl-8 text-start" data-platform-marker>This device</span>
              </div>
              <span class="font-mono text-sm text-bone">{p.requirements}</span>
              <span class="font-mono text-sm text-bone-2">{packages[p.name]}</span>
              <div class="flex flex-wrap gap-2 md:justify-end">
                {links.map((l) => (
                  <a
                    href={l.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-download={l.dataKey}
                    class:list={["btn btn-sm", l.primary ? "btn-secondary" : "btn-ghost"]}
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
            {p.note && (
              <p class="mt-3 max-w-[44rem] text-sm text-bone-3 md:ml-[11rem] md:pl-6">
                <span set:html={p.note} />
              </p>
            )}
          </li>
        );
      })}
    </ul>
    <p class="mt-4 text-sm text-bone-3">
      Older versions are on the
      <a href={releaseUrl} target="_blank" rel="noopener noreferrer" class="text-bone-2 underline decoration-bone-3 underline-offset-4 hover:text-bone">GitHub releases page</a>.
    </p>
  </section>

  <!-- System requirements -->
  <section class="border-y border-line bg-ink-2">
    <div class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
      <p class="label section-label">System requirements</p>
      <div class="mt-6 grid gap-10 lg:grid-cols-12">
        <h2 class="heading text-h2 lg:col-span-8">What your device needs.</h2>
      </div>

      <div class="mt-12 overflow-x-auto">
        <table class="w-full min-w-[46rem] border-t border-line text-left text-sm">
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="label py-3 pr-6 font-medium">Platform</th>
              <th scope="col" class="label py-3 pr-6 font-medium">Min CPU</th>
              <th scope="col" class="label py-3 pr-6 font-medium">Cores</th>
              <th scope="col" class="label py-3 pr-6 font-medium">Min RAM</th>
              <th scope="col" class="label py-3 pr-6 font-medium">Recommended</th>
              <th scope="col" class="label py-3 font-medium">Min GPU</th>
            </tr>
          </thead>
          <tbody>
            {systemRequirements.map((req) => (
              <>
                <tr class:list={[!req.notes && "border-b border-line"]}>
                  <th scope="row" class="py-4 pr-6 align-top font-semibold whitespace-nowrap">
                    <span class="flex items-center gap-3">
                      <Icon name={req.icon} class="h-4 w-4 shrink-0 text-bone-2" aria-hidden="true" />
                      {req.platform}
                    </span>
                  </th>
                  <td class="py-4 pr-6 align-top font-mono text-bone-2">{req.minCpu}</td>
                  <td class="py-4 pr-6 align-top font-mono whitespace-nowrap text-bone-2">{req.cores}</td>
                  <td class="py-4 pr-6 align-top font-mono whitespace-nowrap text-bone-2">{req.minRam}</td>
                  <td class="py-4 pr-6 align-top font-mono whitespace-nowrap text-bone">{req.recRam}</td>
                  <td class="py-4 align-top font-mono text-bone-2">{req.minGpu}</td>
                </tr>
                {req.notes && (
                  <tr class="border-b border-line">
                    <td colspan="6" class="pb-4"><p class="sticky left-0 max-w-[min(40rem,calc(100vw-2.5rem))] pl-7 text-[0.8125rem] text-bone-3">{req.notes}</p></td>
                  </tr>
                )}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Beta and community -->
  <section class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="label section-label">
          <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-start" aria-hidden="true"></span>Active development</span>
        </p>
        <h2 class="heading mt-6 text-h2">This is beta software.</h2>
        <p class="mt-5 max-w-[36rem] text-bone-2">
          These are Beta releases intended for testing and feedback. While stable, you may encounter minor bugs. Join
          the community to report issues and help improve the experience.
        </p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <p class="label section-label">Community</p>
        <h3 class="mt-6 text-h3 leading-tight font-bold">Join the discussion</h3>
        <p class="mt-2 max-w-[36rem] text-bone-2">
          Get help, share themes, report bugs, and stay updated on the latest releases.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://discord.gg/xE2kgKsRVq" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="simple-icons:discord" class="h-4 w-4" aria-hidden="true" />
            Discord
          </a>
          <a href="https://github.com/misobadev/neostation-frontend/discussions" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
            GitHub Discussions
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const API_URL = "https://api.github.com/repos/misobadev/neostation-frontend/releases/latest";

    const primaryLabels: Record<string, string> = {
      windows: "Download for Windows",
      "android-apk": "Download for Android",
      "linux-x64": "Download for Linux (x64)",
      macos: "Download for macOS",
    };

    function detectPlatform(): string | null {
      const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
      const ua = `${nav.userAgentData?.platform ?? ""} ${navigator.userAgent}`.toLowerCase();
      if (/iphone|ipad|ipod/.test(ua)) return null;
      if (/android/.test(ua)) return "android-apk";
      if (/windows/.test(ua)) return "windows";
      if (/mac/.test(ua)) return "macos";
      if (/linux|x11|cros/.test(ua)) return "linux-x64";
      return null;
    }

    const detected = detectPlatform();

    // Point the one main button at the visitor's file, using the row link as the source of truth
    function syncPrimary() {
      const primary = document.querySelector("[data-primary-download]") as HTMLAnchorElement | null;
      if (!primary) return;
      const key = detected ?? "windows";
      const source = document.querySelector(`[data-download="${key}"]`) as HTMLAnchorElement | null;
      const label = primary.querySelector("[data-primary-label]");
      const file = document.querySelector("[data-primary-file]");
      if (source) primary.href = source.href;
      primary.dataset.primaryDownload = key;
      if (label) label.textContent = primaryLabels[key] ?? label.textContent;
      if (file) {
        try {
          file.textContent = decodeURIComponent(new URL(primary.href).pathname.split("/").pop() || "");
        } catch {
          file.textContent = "";
        }
      }
    }

    function markDetectedRow() {
      if (!detected) return;
      for (const row of document.querySelectorAll<HTMLElement>("[data-platform-row]")) {
        const keys = (row.dataset.platformRow || "").split(" ");
        row.querySelector("[data-platform-marker]")?.classList.toggle("hidden", !keys.includes(detected));
      }
    }

    async function loadLatestRelease() {
      try {
        const res = await fetch(API_URL, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!res.ok) return;
        const data = await res.json();

        const badge = document.querySelector("[data-release-badge]") as HTMLAnchorElement | null;
        if (badge) badge.href = data.html_url || badge.href;

        const versionEl = document.querySelector("[data-release-version]");
        const dateEl = document.querySelector("[data-release-date]");
        if (versionEl) {
          versionEl.textContent = data.name
            ? data.name.replace(/^NeoStation\s+/i, "")
            : data.tag_name?.replace(/^v/, "Beta ");
        }
        if (dateEl && data.published_at) {
          const d = new Date(data.published_at);
          dateEl.textContent = d.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
        }

        let seenApk = false;
        for (const asset of data.assets || []) {
          const name = asset.name;
          const url = asset.browser_download_url;
          let key = null;

          if (name.includes("windows") && name.endsWith(".zip")) key = "windows";
          // Releases can carry several APKs; keep arm64-v8a, the build the page lists
          else if (name.includes("android") && name.endsWith(".apk") && (name.includes("arm64") || !seenApk)) {
            key = "android-apk";
            seenApk = name.includes("arm64");
          }
          else if (name.includes("linux") && name.includes("x86_64") && name.endsWith(".AppImage")) key = "linux-x64";
          else if (name.includes("linux") && name.includes("arm64") && name.endsWith(".AppImage")) key = "linux-arm64";
          else if (name.includes("macos") && name.endsWith(".dmg")) key = "macos";

          if (key) {
            const link = document.querySelector(`[data-download="${key}"]`) as HTMLAnchorElement | null;
            if (link) link.href = url;
          }
        }
        syncPrimary();
      } catch (e) {
        console.error("Failed to fetch latest GitHub release:", e);
      }
    }

    syncPrimary();
    markDetectedRow();
    loadLatestRelease();
  </script>
</PageLayout>
