---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
  description:
    "NeoSync keeps your game saves and states in sync between your Windows PC, Android handheld, Mac and Linux machine, so you pick up where you stopped.",
  title: "NeoSync cloud saves",
};

const plans = [
  { name: "Free", cap: "4 MB", price: "Free", annual: "Free" },
  { name: "Micro", cap: "16 MB", price: "$2 / mo", annual: "$20 / yr" },
  { name: "Mini", cap: "64 MB", price: "$3 / mo", annual: "$30 / yr" },
  { name: "Mega", cap: "256 MB", price: "$4 / mo", annual: "$40 / yr" },
  { name: "Ultra", cap: "1 GB", price: "$5 / mo", annual: "$50 / yr" },
];

const engine = [
  { title: "Atomic sync", body: "Fast, low-bandwidth updates that send only what changed." },
  { title: "Multi-platform", body: "Works between Windows, Android, macOS and Linux." },
];

const kinds = [
  {
    title: "Atomic saves",
    body: "The native files the game writes to the console's memory (RAM/SRAM/EEPROM). They are your \"official\" progress.",
    points: [
      { good: true, text: "Extremely small files (bytes to KBs)." },
      { good: true, text: "Fully compatible between different emulators." },
      { good: true, text: "No risk of corruption between core versions." },
    ],
  },
  {
    title: "Capture states",
    body: "Snapshots created by the emulator core. They let you resume exactly where you left off, down to the frame.",
    points: [
      { good: true, text: "Load and resume instantly." },
      { good: false, text: "Large files (can reach 100MB+ for modern systems)." },
      { good: false, text: "Needs identical core versions on every device." },
    ],
  },
];

const emulators = ["RetroArch", "RetroArch32", "RetroArch64", "Eden", "Citro", "NetherSX2"];

const terms = [
  {
    term: "Privacy",
    body: "No telemetry, no tracking and no data harvesting. We don't want your personal data, only your saves.",
  },
  {
    term: "Account",
    body: "Accounts are created only inside the NeoStation app, with no long forms. We only need your email address to confirm the account.",
  },
  {
    term: "Payments",
    body: "Payments are processed by Stripe, used by millions of businesses. NeoGameLab and NeoStation do not store any of your payment or credit card information.",
  },
  {
    term: "Changes",
    body: "Unsubscribe or change your plan at any time. Subscriptions are managed directly in the NeoStation app.",
  },
  {
    term: "Optional",
    body: "NeoSync is optional. NeoStation works fully offline for local collections.",
  },
];
---

<PageLayout meta={meta}>
  <!-- Hero -->
  <section class="mx-auto max-w-[76rem] px-5 pt-14 md:px-8 md:pt-24">
    <div class="flex items-center gap-3">
      <img src="/providers/neosync.svg" alt="" class="h-10 w-10 object-contain" width="40" height="40" />
      <p class="label">NeoSync · Cloud saves for NeoStation</p>
    </div>
    <div class="mt-5 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h1 class="display text-display">Your progress. Everywhere.</h1>
      </div>
      <div class="lg:col-span-5 lg:pb-2">
        <p class="max-w-[40rem] text-lead text-bone-2">
          NeoSync syncs game progress and nothing else. Your saves move between your Windows PC, your Android handheld
          and your Linux machine, so you pick up where you stopped.
        </p>
      </div>
    </div>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="/downloads/" class="btn btn-primary btn-lg pl-2">
        <span class="pad bg-ink text-start" aria-hidden="true">A</span>
        Get started free
      </a>
      <a href="/guide/#neosync" class="btn btn-secondary btn-lg">View setup guide</a>
    </div>

    <div class="screen mx-auto mt-14 max-w-[56rem] md:mt-16">
      <img src="/screenshots/neostation-07.webp?v=20261122" alt="NeoSync online saves" class="block w-full" width="1280" height="960" />
    </div>
  </section>

  <!-- What it syncs -->
  <section class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
    <p class="label section-label">What it syncs</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="heading text-h2">Saves and states only.</h2>
        <p class="mt-5 max-w-[36rem] text-bone-2">
          NeoSync is built for small, frequent updates. It handles SRAM saves and RetroArch snapshots, keeps each update
          atomic, and never touches your game library.
        </p>
      </div>
      <dl class="border-t border-line lg:col-span-5 lg:mt-2">
        {engine.map((e) => (
          <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[10rem_1fr] sm:gap-5">
            <dt class="label pt-0.5">{e.title}</dt>
            <dd class="text-[0.9375rem]">{e.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Saves vs states -->
  <section class="border-y border-line bg-ink-2">
    <div class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
      <p class="label section-label">Saves vs. states</p>
      <div class="mt-6 grid gap-10 lg:grid-cols-12">
        <h2 class="heading text-h2 lg:col-span-8">Two kinds of progress, with different trade-offs.</h2>
      </div>
      <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-10">
        {kinds.map((k) => (
          <div class="border-t border-bone-3 pt-5">
            <h3 class="text-h3 font-bold leading-tight">{k.title}</h3>
            <p class="mt-3 max-w-[36rem] text-bone-2">{k.body}</p>
            <ul class="mt-6 border-t border-line">
              {k.points.map((p) => (
                <li class="flex items-start gap-3 border-b border-line py-3.5">
                  <Icon
                    name={p.good ? "heroicons:check" : "heroicons:exclamation-triangle"}
                    class:list={["mt-1 h-4 w-4 shrink-0", p.good ? "text-bone-3" : "text-bone"]}
                    aria-label={p.good ? "Advantage" : "Drawback"}
                  />
                  <span class="text-[0.9375rem] text-bone-2">{p.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Supported emulators -->
  <section class="mx-auto max-w-[76rem] px-5 py-16 md:px-8 lg:py-24">
    <p class="label section-label">Supported emulators</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="heading text-h2">Works with these emulators today.</h2>
        <p class="mt-5 max-w-[36rem] text-bone-2">NeoSync currently syncs saves and states from the following emulators.</p>
      </div>
    </div>
    <ul class="mt-12 grid grid-cols-2 border-t border-line md:grid-cols-3">
      {emulators.map((emu) => (
        <li class="border-b border-line py-4 font-mono text-[0.9375rem] font-medium">{emu}</li>
      ))}
    </ul>
  </section>

  <!-- Plans -->
  <section class="mx-auto max-w-[76rem] px-5 pb-22 md:px-8 lg:pb-32">
    <p class="label section-label">Storage plans</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="heading text-h2">Start free. Pay only for more space.</h2>
        <p class="mt-5 max-w-[36rem] text-bone-2">
          The free plan is enough for classic 8/16-bit collections, with no tricks. Paid plans suit modern systems and
          heavy use of states. Paying yearly saves 17%.
        </p>
      </div>
    </div>

    <table class="mt-12 w-full border-collapse text-left">
      <thead>
        <tr class="border-b border-bone-3">
          <th scope="col" class="label py-3 pr-3 font-medium">Plan</th>
          <th scope="col" class="label py-3 pr-3 font-medium">Storage</th>
          <th scope="col" class="label py-3 pr-3 font-medium">Monthly</th>
          <th scope="col" class="label py-3 font-medium">Yearly</th>
        </tr>
      </thead>
      <tbody>
        {plans.map((plan) => (
          <tr class="border-b border-line">
            <th scope="row" class="py-4 pr-3 font-semibold">{plan.name}</th>
            <td class="py-4 pr-3 font-mono text-[0.9375rem] font-semibold">{plan.cap}</td>
            <td class="py-4 pr-3 font-mono text-[0.9375rem] text-bone-2">{plan.price}</td>
            <td class="py-4 font-mono text-[0.9375rem] text-bone-2">
              <span class="whitespace-nowrap">{plan.annual}</span>
              {plan.name !== "Free" && <span class="label mt-0.5 block sm:ml-2 sm:mt-0 sm:inline">Save 17%</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <dl class="mt-16 border-t border-line">
      {terms.map((t) => (
        <div class="grid gap-1 border-b border-line py-4 md:grid-cols-12 md:gap-8">
          <dt class="label pt-0.5 md:col-span-3">{t.term}</dt>
          <dd class="max-w-[40rem] text-[0.9375rem] text-bone-2 md:col-span-9">{t.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Closing -->
  <section class="border-t border-line">
    <div class="mx-auto grid max-w-[76rem] gap-10 px-5 py-16 md:px-8 lg:grid-cols-12 lg:items-end lg:py-24">
      <div class="lg:col-span-7">
        <p class="label section-label">Start syncing</p>
        <h2 class="heading mt-6 text-h2">Ready to synchronize?</h2>
        <p class="mt-5 max-w-[36rem] text-bone-2">
          NeoSync is built into the NeoStation app. Log in with your account to start syncing across Windows, Android
          and Linux.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href="/downloads/" class="btn btn-primary btn-lg pl-2">
          <span class="pad bg-ink text-start" aria-hidden="true">A</span>
          Get started free
        </a>
        <a href="/guide/#neosync" class="btn btn-secondary btn-lg">View setup guide</a>
      </div>
    </div>

    <!-- Legal & functional disclaimer -->
    <div class="mx-auto max-w-[76rem] px-5 pb-22 md:px-8 lg:pb-32">
      <div class="rounded-2xl border border-line bg-ink-2 p-6 md:p-8">
        <p class="label">Legal and functional disclaimer</p>
        <p class="mt-3 max-w-[48rem] text-[0.9375rem] text-bone-2">
          NeoSync <strong class="font-semibold text-bone">does not synchronize games (ROMs)</strong>. Backing up
          interactive software you do not own is illegal. The service only synchronizes user-generated progress (saves
          and states) across devices. You are responsible for your own legal game library.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
